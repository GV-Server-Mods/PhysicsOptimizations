                                                                                   Foreground="#E0E0E0"
                                                                                   Margin="0,6,0,3"/>
                                                                        <RadioButton Content="Optimized Damage (Anti-Exploit Only)"
                                                                                     IsChecked="{Binding Config.IsThrusterModeOptimized}"
                                                                                     Foreground="#EEEEEE"
                                                                                     Margin="0,2,0,2"
                                                                                     ToolTip="Maximum performance mode. Raycast clearance checks local construct only: instantly vaporizes illegal internal blocks built directly inside exhaust plumes. External grids (carrier decks, landing pads) are 100% immune (0 damage, 0 Havok phantoms)."/>
                                                                        <RadioButton Content="Vanilla-Like Damage (Authentic Rate &amp; External Grids)"
                                                                                     IsChecked="{Binding Config.IsThrusterModeVanillaLike}"
                                                                                     Foreground="#EEEEEE"
                                                                                     Margin="0,2,0,2"
                                                                                     ToolTip="Uses multi-nozzle raycasts to apply gradual, authentic vanilla-rate thermal damage (MyDamageType.Thruster) to both own construct and external grids (landing pads, carrier decks, enemy hulls)."/>

                                                                        <TextBlock Text="💡 Optimized mode grants 100% immunity to landing pads and carrier decks. Vanilla-Like mode applies realistic gradual thermal damage across all grids."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="10"
                                                                                   Margin="0,4,0,2"
                                                                                   TextWrapping="Wrap"/>

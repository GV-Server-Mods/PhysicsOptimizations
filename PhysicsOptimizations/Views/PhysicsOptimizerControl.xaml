                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 IsEnabled="{Binding Config.EnableAltitudeTOIReversion}"
                                                                                                 ToolTip="Planetary surface distance below which Continuous TOI is strictly enforced. Default: 50m."/>
                                                                                        <TextBlock Text="Meters Altitude."
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                        </StackPanel>

                                                                        <!-- Priority note -->
                                                                        <TextBlock Text="💡 Priority: PMW Missiles (Continuous) &gt; Grid-Size Discrete &gt; Terrain/Grid Proximity &gt; Speed Thresholds"
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="10"
                                                                                   Margin="16,8,0,2"
                                                                                   TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                        </StackPanel>
                                                </GroupBox>



                                                <GroupBox Header="🔥 Thruster Clearance Optimizer">
                                                        <StackPanel>
                                                                <CheckBox Content="Enable Thruster Clearance Optimizer"
                                                                          IsChecked="{Binding Config.EnableThrusterClearance}"
                                                                          FontWeight="SemiBold"
                                                                          Margin="0,0,0,6"
                                                                          ToolTip="Master toggle for raycast-based thruster damage optimizations, multi-nozzle dummy iteration, and radial coverage for large/modded thrusters."/>
                                                                <StackPanel IsEnabled="{Binding Config.EnableThrusterClearance}"
                                                                            Margin="16,0,0,0">

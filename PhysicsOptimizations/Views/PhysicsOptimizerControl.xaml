<UserControl x:Class="PhysicsOptimizer.Views.PhysicsOptimizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:PhysicsOptimizer.Views"
             mc:Ignorable="d"
             d:DesignHeight="950"
             d:DesignWidth="800">
        <UserControl.Resources>
                <views:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis"/>
                <views:NullToVisibilityConverter x:Key="NullToVis"/>
                <views:InvertedNullToVisibilityConverter x:Key="InvertedNullToVis"/>
                <views:EmptyCollectionToVisibilityConverter x:Key="EmptyColToVis"/>
                <views:NonEmptyCollectionToVisibilityConverter x:Key="NonEmptyColToVis"/>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <Style TargetType="GroupBox">
                        <Setter Property="Margin"
                                Value="0,0,0,12"/>
                        <Setter Property="Padding"
                                Value="10"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="BorderBrush"
                                Value="#444444"/>
                        <Setter Property="Foreground"
                                Value="#EEEEEE"/>
                </Style>
                <Style TargetType="Label">
                        <Setter Property="Foreground"
                                Value="#CCCCCC"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                        <Setter Property="Padding"
                                Value="0"/>
                </Style>
                <Style TargetType="TextBox">
                        <Setter Property="Margin"
                                Value="5,2"/>
                        <Setter Property="Padding"
                                Value="4,2"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                </Style>
                <Style TargetType="CheckBox">
                        <Setter Property="Margin"
                                Value="0,2,5,2"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                        <Setter Property="Foreground"
                                Value="#EEEEEE"/>
                </Style>
                <Style TargetType="RadioButton">
                        <Setter Property="Margin"
                                Value="0,2,5,2"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                        <Setter Property="Foreground"
                                Value="#EEEEEE"/>
                </Style>
                <Style TargetType="Button">
                        <Setter Property="Padding"
                                Value="12,6"/>
                        <Setter Property="Margin"
                                Value="5"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                </Style>
                <Style TargetType="ToolTip">
                        <Setter Property="MaxWidth"
                                Value="380"/>
                        <Setter Property="Background"
                                Value="#2D2D30"/>
                        <Setter Property="Foreground"
                                Value="#F1F1F1"/>
                        <Setter Property="BorderBrush"
                                Value="#007ACC"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Padding"
                                Value="8,6"/>
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="ContentTemplate">
                                <Setter.Value>
                                        <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="Wrap"/>
                                        </DataTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <Style x:Key="DualColorProgressBarStyle"
                       TargetType="ProgressBar">
                        <Setter Property="Height"
                                Value="6"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ProgressBar">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="2"
                                                        ClipToBounds="True">
                                                        <Grid Name="PART_Track">
                                                                <Border Name="PART_Indicator"
                                                                        Background="{TemplateBinding Foreground}"
                                                                        HorizontalAlignment="Left"/>
                                                        </Grid>
                                                </Border>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </UserControl.Resources>

        <Grid Margin="15">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="#1E1E1E"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal"
                                   VerticalAlignment="Center">
                                <WrapPanel Orientation="Horizontal"
                                           VerticalAlignment="Center"
                                           Margin="0,4,20,4">
                                        <TextBlock Text="⚡ Physics Optimizer v2.0.0"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="#4CAF50"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <CheckBox Content="Enable Plugin"
                                                  IsChecked="{Binding Config.Enabled}"
                                                  FontWeight="Bold"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"
                                                  ToolTip="Master switch for the entire Physics Optimizer plugin. Disabling suspends all background optimization loops, patches, and collision defenses."/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,4,0,4">
                                        <Button Content="Save Config to Disk"
                                                Click="SaveButton_OnClick"
                                                Background="#2E7D32"
                                                Foreground="White"
                                                BorderThickness="0"
                                                ToolTip="Forces an immediate save of current configuration values to PhysicsOptimizer.cfg on disk."/>
                                </StackPanel>
                        </WrapPanel>
                </Border>

                <!-- Main Tab Control (3 Tabs) -->
                <TabControl Grid.Row="1"
                            Background="#252526"
                            BorderBrush="#333333">

                        <!-- TAB 1: PHYSICS OPTIMIZATIONS (all optimizer modules merged) -->
                        <TabItem Header="Physics Optimizations">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="10">
                                        <StackPanel IsEnabled="{Binding Config.EnablePhysicsOptimizations}">
                                                <!-- Suite Summary -->
                                                <Border Background="#1F2937"
                                                        BorderBrush="#3B82F6"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10"
                                                        Margin="0,0,0,12">
                                                        <StackPanel>
                                                                <TextBlock Text="⚙️ Physics Optimization Suite:"
                                                                           FontWeight="Bold"
                                                                           Foreground="#60A5FA"
                                                                           Margin="0,0,0,4"/>
                                                                <TextBlock Text="Six cooperative Havok load reducers, each with its own master toggle below: Wheel Optimizer parks suspension raycasts on idle rovers, Rigid Body Sleep puts motionless grids into Havok sleep, Ore Merge consolidates floating ore stacks, Subgrid Stabilizer dampens resting mechanical joints, Adaptive Collision demotes cruising grids to Discrete collision, and Thruster Clearance replaces flame shape-casts with multi-nozzle raycasts. Disabling the suite master switch pauses all six while leaving Grid Defender fully active."
                                                                <TextBlock Text="Seven cooperative Havok load reducers, each with its own master toggle below: Wheel Optimizer parks suspension raycasts on idle rovers, Rigid Body Sleep puts motionless grids into Havok sleep, Ore Merge consolidates floating ore stacks, Subgrid Stabilizer dampens resting mechanical joints, Adaptive Collision demotes cruising grids to Discrete collision, Thruster Clearance replaces flame shape-casts with multi-nozzle raycasts, and Tree Physics Optimizer disables server-side flora collision meshes. Disabling the suite master switch pauses all seven while leaving Grid Defender fully active."
                                                                           Foreground="#D1D5DB"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                </Border>

                                                <!-- Wheel & Suspension -->
                                                <GroupBox Header="🏎️ Wheel Optimizer">
                                                        <StackPanel>
                                                                <CheckBox Content="Enable Wheel Optimizer"
                                                                          IsChecked="{Binding Config.EnableWheelOptimizer}"
                                                                          FontWeight="SemiBold"
                                                                          Margin="0,0,0,6"
                                                                          ToolTip="Master toggle for wheel and suspension optimizations. Controls parked rover suspension sleep and symmetrical wheel well collision filtering."/>
                                                                <StackPanel IsEnabled="{Binding Config.EnableWheelOptimizer}">
                                                                        <TextBlock Text="Sleeps 60Hz raycasts on parked rovers and masks wheel well armor to eliminate compound shape collision checks."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   Margin="16,0,0,8"
                                                                                   TextWrapping="Wrap"/>
                                                                        <CheckBox Content="Enable Symmetrical Wheel Well Collision Masking"
                                                                                  IsChecked="{Binding Config.EnableWheelCollisionFilter}"
                                                                                  Margin="16,2,0,2"
                                                                                  ToolTip="Applies Havok collision bitmasks to prevent wheels from performing compound shape collision checks against their own chassis wheel well armor blocks."/>
                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center">
                                                                                <CheckBox Content="Sleep Parked Rover Suspensions after remaining motionless for"
                                                                                          IsChecked="{Binding Config.SleepParkedRovers}"
                                                                                          VerticalAlignment="Center"
                                                                                          ToolTip="Suspends 60Hz suspension raycasts, air-shock updates, and brake checks on rovers that are stationary with handbrake engaged. Wakes on input, damage, or movement."/>
                                                                                <TextBox Text="{Binding Config.RoverSleepDelaySeconds, StringFormat={}{0:F1}}"
                                                                                         Width="55"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         IsEnabled="{Binding Config.SleepParkedRovers}"
                                                                                         ToolTip="Seconds a parked rover must remain motionless before its suspension raycasts are put to sleep. Default: 2.0s."/>
                                                                                <TextBlock Text="Seconds."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>
                                                                </StackPanel>
                                                        </StackPanel>
                                                </GroupBox>



                                                <!-- Rigid Body Sleeping -->
                                                <GroupBox Header="💤 Rigid Body Sleep">
                                                        <StackPanel>
                                                                <CheckBox Content="Enable Rigid Body Sleep"
                                                                          IsChecked="{Binding Config.EnableRigidBodySleep}"
                                                                          FontWeight="SemiBold"
                                                                          Margin="0,0,0,6"
                                                                          ToolTip="Actively deactivates Havok rigid bodies on idle, unpiloted, and supported dynamic grids into Havok sleep mode to eliminate solver CPU overhead."/>
                                                                <StackPanel IsEnabled="{Binding Config.EnableRigidBodySleep}">
                                                                        <TextBlock Text="Deactivates motionless unpiloted dynamic grids into Havok sleep mode, waking instantly on cockpit input, damage, or movement."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   Margin="16,0,0,8"
                                                                                   TextWrapping="Wrap"/>

                                                                        <StackPanel Margin="16,2,0,2">
                                                                                <WrapPanel Margin="0,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Deactivate unpiloted grids when Linear Velocity is below"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.SleepLinearVelocityThreshold, StringFormat={}{0:F2}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Maximum linear speed below which an unpiloted grid is considered at rest and eligible for Havok sleep. Default: 0.05 m/s."/>
                                                                                        <TextBlock Text="m/s"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                                <WrapPanel Margin="0,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="and Angular Velocity is below"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.SleepAngularVelocityThreshold, StringFormat={}{0:F3}}"
                                                                                                 Width="65"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Maximum rotational speed below which an unpiloted grid is considered at rest and eligible for Havok sleep. Default: 0.01 rad/s."/>
                                                                                        <TextBlock Text="rad/s"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                                <WrapPanel Margin="0,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="after remaining motionless for"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.IdleSecondsBeforeSleep}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Consecutive seconds an unpiloted grid must remain under velocity thresholds before entering Havok sleep. Default: 3s."/>
                                                                                        <TextBlock Text="Seconds."
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </StackPanel>
                                                </GroupBox>



                                                <!-- Floating Objects & Ore -->
                                                <GroupBox Header="⛏️ Ore Merge">
                                                        <StackPanel>
                                                                <CheckBox Content="Enable Ore Merge"
                                                                          IsChecked="{Binding Config.EnableOreMerge}"
                                                                          FontWeight="SemiBold"
                                                                          Margin="0,0,0,6"
                                                                          ToolTip="Master toggle for floating objects and ore optimizations. Merges nearby floating ores and dropped item entities."/>
                                                                <StackPanel IsEnabled="{Binding Config.EnableOreMerge}">
                                                                        <TextBlock Text="Merges nearby floating ore rocks and items into single larger stacks to slash rigid body counts and accelerate sector cleanup."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   Margin="16,0,0,8"
                                                                                   TextWrapping="Wrap"/>

                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center">
                                                                                <CheckBox Content="Auto-Merge Nearby Floating Ore &amp; Items within"
                                                                                          IsChecked="{Binding Config.AutoMergeNearbyOre}"
                                                                                          VerticalAlignment="Center"/>
                                                                                <TextBox Text="{Binding Config.OreMergeRadiusMeters, StringFormat={}{0:F1}}"
                                                                                         Width="55"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         IsEnabled="{Binding Config.AutoMergeNearbyOre}"
                                                                                         ToolTip="Spatial radius within which matching floating items and ores will merge into a single item stack. Default: 3.0m."/>
                                                                                <TextBlock Text="Meters every"
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,5,0"/>
                                                                                <TextBox Text="{Binding Config.OreMergeIntervalTicks}"
                                                                                         Width="55"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         IsEnabled="{Binding Config.AutoMergeNearbyOre}"
                                                                                         ToolTip="Simulation frames between proximity merge sweeps (60 = 1 sec, 120 = 2 sec). Default: 120 ticks."/>
                                                                                <TextBlock Text="Ticks (60 = ~1s)."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>
                                                                </StackPanel>
                                                        </StackPanel>
                                                </GroupBox>



                                                <!-- Subgrid Constraints -->
                                                <GroupBox Header="🦾 Subgrid Stabilizer">
                                                        <StackPanel>
                                                                <CheckBox Content="Enable Subgrid Stabilizer"
                                                                          IsChecked="{Binding Config.EnableSubgridStabilizer}"
                                                                          FontWeight="SemiBold"
                                                                          Margin="0,0,0,6"
                                                                          ToolTip="Master toggle for subgrid constraint stabilization. Micro-dampens velocity drift between resting subgrids and parent grids and masks small utility subgrids to eliminate Clang oscillation loops."/>
                                                                <CheckBox Content="Exclude Suspension Wheel Subgrids from Stabilization"
                                                                          IsChecked="{Binding Config.ExcludeWheelSubgridsFromSubgridStabilizer}"
                                                                          Margin="16,2,0,2"
                                                                          ToolTip="Suspension wheels are separate physics bodies; stabilizing their joint can fight the suspension solver and create driving lag. When enabled, wheel joints are skipped."/>
                                                                <StackPanel IsEnabled="{Binding Config.EnableSubgridStabilizer}">
                                                                        <TextBlock Text="Micro-dampens constraint tension on resting mechanical joints (rotors, hinges, pistons) and masks small utility subgrids to stop Clang loops."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   Margin="16,0,0,8"
                                                                                   TextWrapping="Wrap"/>

                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center">
                                                                                <CheckBox Content="Stabilize all mechanical joints when Velocity is below"
                                                                                          IsChecked="{Binding Config.EnableSubgridStabilization}"
                                                                                          VerticalAlignment="Center"/>
                                                                                <TextBox Text="{Binding Config.SubgridRestVelocityThreshold, StringFormat={}{0:F3}}"
                                                                                         Width="65"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         IsEnabled="{Binding Config.EnableSubgridStabilization}"
                                                                                         ToolTip="Relative angular velocity threshold below which any mechanical joint (rotors, hinges, pistons across all subgrids) is considered resting and eligible for stabilization. Default: 0.005 rad/s."/>
                                                                                <TextBlock Text="rad/s for"
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,5,0"/>
                                                                                <TextBox Text="{Binding Config.SubgridRestFramesThreshold}"
                                                                                         Width="55"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         IsEnabled="{Binding Config.EnableSubgridStabilization}"
                                                                                         ToolTip="Consecutive motionless frames before stabilizing the joint constraint solver (60 = ~1s). Applies to all mechanical joints across all subgrids. Default: 60 frames."/>
                                                                                <TextBlock Text="Frames (~1s)."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>

                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center">
                                                                                <CheckBox Content="Mask Small Utility Subgrids under"
                                                                                          IsChecked="{Binding Config.MaskSmallUtilitySubgrids}"
                                                                                          VerticalAlignment="Center"/>
                                                                                <TextBox Text="{Binding Config.MaskSmallUtilitySubgridMaxBlocks}"
                                                                                         Width="65"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         IsEnabled="{Binding Config.MaskSmallUtilitySubgrids}"
                                                                                         ToolTip="Maximum block count for a utility subgrid to be eligible for broadphase collision masking. Subgrids with this many blocks or fewer are masked. Default: 10 blocks."/>
                                                                                <TextBlock Text="Blocks."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>
                                                                </StackPanel>
                                                        </StackPanel>
                                                </GroupBox>



                                                <!-- Adaptive TOI / Collision Detection -->
                                                <GroupBox Header="🚀 Adaptive Collision">
                                                        <StackPanel>
                                                                <CheckBox Content="Enable Adaptive Collision"
                                                                          IsChecked="{Binding Config.EnableAdaptiveCollision}"
                                                                          FontWeight="SemiBold"
                                                                          Margin="0,0,0,6"
                                                                          ToolTip="Master toggle for dynamic Discrete/Continuous collision quality optimization. Demotes slow, isolated grids to Discrete to save CPU while enforcing Continuous near hazards and high speeds."/>
                                                                <StackPanel IsEnabled="{Binding Config.EnableAdaptiveCollision}">
                                                                        <TextBlock Text="Demotes cruising and large grids to Discrete collision to slash broadphase CPU load while preserving Continuous TOI for missiles and hazards."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   Margin="16,0,0,4"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Margin="16,0,0,8"
                                                                                   FontSize="11"
                                                                                   Foreground="#9CA3AF"
                                                                                   TextWrapping="Wrap">
                                        <Run Text="• Discrete:"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="#E0E0E0"/>
                                        <Run Text=" Checks contacts per tick (slashes CPU load, best for rovers &amp; large grids)."/>
                                        <LineBreak/>
                                        <Run Text="• Continuous (TOI):"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="#E0E0E0"/>
                                        <Run Text=" Sweeps path between ticks (prevents high-speed tunneling, burns more CPU)."/>
                                                                        </TextBlock>

                                                                        <!-- Section A: Grid-Size Discrete Architecture Overrides -->
                                                                        <TextBlock Text="Permanent Discrete: Thresholds"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#E0E0E0"
                                                                                   Margin="16,6,0,3"
                                                                                   ToolTip="Forces specified grid sizes into Discrete physics to drastically reduce physics solver load. Works with GridDefender Push-Apart &amp; Anti-Clang for repulsion."/>

                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center">
                                                                                <CheckBox Content="Enforce Discrete on Large Grids over"
                                                                                          IsChecked="{Binding Config.EnforceDiscreteLargeGrids}"
                                                                                          VerticalAlignment="Center"/>
                                                                                <TextBox Text="{Binding Config.DiscreteLargeGridMinBlocks}"
                                                                                         Width="65"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         IsEnabled="{Binding Config.EnforceDiscreteLargeGrids}"
                                                                                         ToolTip="Minimum block count for large grids to qualify for forced discrete collision (0 = all large grids). Default: 20 blocks."/>
                                                                                <TextBlock Text="Blocks."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>

                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center">
                                                                                <CheckBox Content="Enforce Discrete on Small Grids over"
                                                                                          IsChecked="{Binding Config.EnforceDiscreteSmallGrids}"
                                                                                          VerticalAlignment="Center"/>
                                                                                <TextBox Text="{Binding Config.DiscreteSmallGridMinBlocks}"
                                                                                         Width="65"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         IsEnabled="{Binding Config.EnforceDiscreteSmallGrids}"
                                                                                         ToolTip="Minimum block count for small grids to qualify for forced discrete collision (0 = all small grids). Default: 40 blocks."/>
                                                                                <TextBlock Text="Blocks."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>

                                                                        <TextBlock Text="🚀 Note: Active PMW missiles (Grid Defender tab) always retain Continuous TOI."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="10"
                                                                                   Margin="16,3,0,6"
                                                                                   ToolTip="Valid player-made missiles configured in Grid Defender always bypass discrete overrides to guarantee impact detection and kinetic penetration."
                                                                                   TextWrapping="Wrap"/>

                                                                        <!-- Section B: Speed Thresholds & Hysteresis -->
                                                                        <TextBlock Text="Dynamic Discrete: Thresholds"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#E0E0E0"
                                                                                   Margin="16,6,0,3"
                                                                                   ToolTip="Fallback rules for grids not covered by the discrete overrides above."/>

                                                                        <StackPanel Margin="16,2,0,2">
                                                                                <WrapPanel Margin="0,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <CheckBox Content="Demote to Discrete below"
                                                                                                  IsChecked="{Binding Config.EnableSpeedThresholds}"
                                                                                                  VerticalAlignment="Center"/>
                                                                                        <TextBox Text="{Binding Config.DiscreteCollisionSpeedThreshold, StringFormat={}{0:F1}}"
                                                                                                 Width="60"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 IsEnabled="{Binding Config.EnableSpeedThresholds}"
                                                                                                 ToolTip="Demotion ceiling: Grids cruising below this speed switch to Discrete collision to eliminate expensive broadphase queries. Default: 15 m/s."/>
                                                                                        <TextBlock Text="m/s"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                                <WrapPanel Margin="0,2,0,2"
                                                                                           VerticalAlignment="Center"
                                                                                           IsEnabled="{Binding Config.EnableSpeedThresholds}">
                                                                                        <TextBlock Text="and promote to Continuous above"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.ContinuousCollisionSpeedThreshold, StringFormat={}{0:F1}}"
                                                                                                 Width="60"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Promotion floor: Grids accelerating above this speed are immediately restored to Continuous TOI to prevent tunneling. Default: 40 m/s."/>
                                                                                        <TextBlock Text="m/s."
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                        </StackPanel>

                                                                        <!-- Section C: Safety Overrides (For Non-Overridden Grids) -->
                                                                        <StackPanel IsEnabled="{Binding Config.EnableSpeedThresholds}">
                                                                                <TextBlock Text="Dynamic Discrete: Safety Overrides"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#E0E0E0"
                                                                                           Margin="16,6,0,3"
                                                                                           ToolTip="Safety overrides for dynamic speed thresholds: Keeps slow grids in Continuous TOI when near terrain or other craft to prevent clipping. Active only when Speed Thresholds are enabled."/>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <CheckBox Content="Promote to Continuous Near Other Dynamic Grids within"
                                                                                                  IsChecked="{Binding Config.RevertNearOtherDynamicGrids}"
                                                                                                  VerticalAlignment="Center"/>
                                                                                        <TextBox Text="{Binding Config.DynamicGridProximityRevertDistanceMeters, StringFormat={}{0:F0}}"
                                                                                                 Width="65"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 IsEnabled="{Binding Config.RevertNearOtherDynamicGrids}"
                                                                                                 ToolTip="Distance threshold around dynamic grids within which Continuous TOI is strictly enforced. Default: 500m."/>
                                                                                        <TextBlock Text="Meters."
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>

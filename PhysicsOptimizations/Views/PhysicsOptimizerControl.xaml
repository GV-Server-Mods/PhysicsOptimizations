                                </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: GRID DEFENDER -->
                        <TabItem Header="Grid Defender">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="10">
                                        <StackPanel>
                                                <!-- Overview Banner -->
                                                <Border Background="#1F2937"
                                                        BorderBrush="#3B82F6"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10"
                                                        Margin="0,0,0,12">
                                                        <StackPanel>
                                                                <TextBlock Text="💡 Grid Defender Overview:"
                                                                           FontWeight="Bold"
                                                                           Foreground="#60A5FA"
                                                                           Margin="0,0,0,4"/>
                                                                <TextBlock Text="Zero-cost collision defense and kinetic damage interception system. Intercepts Keen's deformation solver to suppress accidental terrain clangs, grief ramming, and subgrid Clang while preserving authentic Havok momentum. Valid player-made missiles (PMWs) deal full kinetic deformation damage, external armor layers occlude interior blocks, kinetic dampening stops rotational death spins, stuck overlapping grids are gently separated, and thruster damage checks use optimized multi-nozzle raycasts."
                                                                           Foreground="#D1D5DB"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                </Border>

                                                <!-- Master Grid Defender Toggle -->
                                                <GroupBox Header="🛡️ Master Grid Defender">
                                                        <StackPanel>
                                                                <CheckBox Content="Enable Grid Defender"
                                                                          IsChecked="{Binding Config.EnableGridDefender}"
                                                                          FontWeight="Bold"
                                                                          Margin="0,0,0,6"
                                                                          ToolTip="Master switch for Grid Defender collision protection, anti-clang damping, and grid separation."/>

                                                                <StackPanel IsEnabled="{Binding Config.EnableGridDefender}">
                                                                        <TextBlock Text="Master switch for collision defense and kinetic damage interception. Intercepts Keen's deformation solver to suppress clang damage, scale impact multipliers, and separate grids."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   Margin="16,0,0,8"
                                                                                   TextWrapping="Wrap"/>
                                                                        <Grid Margin="16,2,0,2">
                                                                                <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="260"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Label Grid.Column="0"
                                                                                       Content="Allowed Impact Damage Multiplier (0.0 to 1.0):"
                                                                                       Padding="0"
                                                                                       VerticalAlignment="Center"
                                                                                       ToolTip="Scale factor when collision impact damage is allowed for missiles (1.0 = normal vanilla damage, 0.5 = 50% damage, 0.0 = zero damage)."/>
                                                                                <Grid Grid.Column="1">
                                                                                        <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="60"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Slider Grid.Column="0"
                                                                                                Minimum="0.0"
                                                                                                Maximum="1.0"
                                                                                                Value="{Binding Config.DeformationMultiplier}"
                                                                                                SmallChange="0.05"
                                                                                                LargeChange="0.1"
                                                                                                VerticalAlignment="Center"
                                                                                                Margin="5,0"
                                                                                                ToolTip="Damage multiplier when impact damage is permitted (e.g., missiles). 1.0 = full damage, 0.0 = zero damage."/>
                                                                                        <TextBox Grid.Column="1"
                                                                                                 Text="{Binding Config.DeformationMultiplier, StringFormat={}{0:F2}}"
                                                                                                 Width="50"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 ToolTip="Damage multiplier when impact damage is permitted (e.g., missiles). 1.0 = full damage, 0.0 = zero damage."/>
                                                                                </Grid>
                                                                        </Grid>
                                                                </StackPanel>
                                                        </StackPanel>
                                                </GroupBox>

                                                <!-- Collision Damage Defense Container -->
                                                <StackPanel IsEnabled="{Binding Config.EnableGridDefender}">

                                                        <!-- Ship, Rover & Station Protection -->
                                                        <GroupBox Header="🚀 Ship, Rover &amp; Station Protection">
                                                                <StackPanel>
                                                                        <TextBlock Text="Protects non-missile ships, rovers, stations, and subgrids against collision deformation from ramming, terrain clangs, subgrid Clang, and debris."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   Margin="16,0,0,8"
                                                                                   TextWrapping="Wrap"/>
                                                                        <CheckBox Content="Protect Ships From Ship-on-Ship Ramming"
                                                                                  IsChecked="{Binding Config.ProtectShipsAgainstRamming}"
                                                                                  Margin="16,2,0,2"
                                                                                  ToolTip="Blocks impact damage when full-sized ships or rovers collide with each other, preventing grief ramming and accidental dock collisions."/>
                                                                        <CheckBox Content="Protect Ships &amp; Rovers From Voxel (Planet/Asteroid) Clangs"
                                                                                  IsChecked="{Binding Config.ProtectShipsAgainstVoxels}"
                                                                                  Margin="16,2,0,2"
                                                                                  ToolTip="Blocks impact damage when rovers or ships hit terrain, dunes, or asteroids. Keeps rovers driving smoothly without deformation lag."/>
                                                                        <CheckBox Content="Protect Static Grids (Stations) From Ramming"
                                                                                  IsChecked="{Binding Config.ProtectStaticGrids}"
                                                                                  Margin="16,2,0,2"
                                                                                  ToolTip="Suppresses collision impact damage on stations and anchored static structures when rammed by ships."/>
                                                                        <CheckBox Content="Protect Against Floating Objects / Debris / Ores"
                                                                                  IsChecked="{Binding Config.ProtectAgainstFloatingObjects}"
                                                                                  Margin="16,2,0,2"
                                                                                  ToolTip="Suppresses impact damage from floating ores, dropped items, and detached debris hitting hulls."/>
                                                                        <CheckBox Content="Protect Subgrids / Mechanicals (Pistons, Rotors, Hinges) from Clang"
                                                                                  IsChecked="{Binding Config.ProtectSubgrids}"
                                                                                  Margin="16,2,0,2"
                                                                                  ToolTip="Suppresses self-collision impact damage between connected subgrids (rotors, hinges, pistons) to stop Clang chain reactions."/>
                                                                        <CheckBox Content="Enable Voxel Normal Force Arbitrator"
                                                                                  IsChecked="{Binding Config.EnableVoxelNormalArbitrator}"
                                                                                  Margin="16,2,0,2"
                                                                                  ToolTip="Evaluates Havok contact point normals relative to Body A vs Body B orientation. If the effective force normal on the grid points downward into voxels, it inverts the normal upward and injects upward separating velocity directly into Havok's active solver step. Fully independent of Push-Apart: either feature can be toggled alone."/>

                                                                        <!-- Fallback Velocity Gates & Damage Rate Limits -->
                                                                        <Border Background="#1E293B"
                                                                                BorderBrush="#475569"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="8"
                                                                                Margin="16,8,0,6">
                                                                                <TextBlock Text="ℹ️ Fallback Velocity Gates: Applied only when Ramming, Voxel, or Station protection is unchecked above. When all three are checked, full collision immunity is active and these fallback gates are bypassed."
                                                                                           Foreground="#94A3B8"
                                                                                           FontSize="11"
                                                                                           TextWrapping="Wrap"/>
                                                                        </Border>
                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center"
                                                                                   IsEnabled="{Binding Config.IsSpeedGatesApplicable}">
                                                                                <TextBlock Text="Safe harbor: Suppress damage when driving below"
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,5,0"/>
                                                                                <TextBox Text="{Binding Config.MinDrivingVelocity, StringFormat={}{0:F1}}"
                                                                                         Width="55"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="0,0,5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         ToolTip="Fallback: Collisions below this speed never deal damage when ramming or voxel protection is disabled. Default: 10 m/s."/>
                                                                                <TextBlock Text="m/s."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>

                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center"
                                                                                   IsEnabled="{Binding Config.IsSpeedGatesApplicable}">
                                                                                <TextBlock Text="Anti-clang: Skip deformation processing above"
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,5,0"/>
                                                                                <TextBox Text="{Binding Config.MaxDeformationVelocity, StringFormat={}{0:F1}}"
                                                                                         Width="55"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="0,0,5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         ToolTip="Fallback: Extreme-speed collisions above this speed skip damage processing to prevent server lag freezes when ramming is allowed. Default: 110 m/s."/>
                                                                                <TextBlock Text="m/s."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>

                                                                        <WrapPanel Margin="16,2,0,2"
                                                                                   VerticalAlignment="Center"
                                                                                   IsEnabled="{Binding Config.IsSpeedGatesApplicable}">
                                                                                <TextBlock Text="Enforce impact damage cooldown of"
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,5,0"/>
                                                                                <TextBox Text="{Binding Config.DeformationCooldownFrames}"
                                                                                         Width="55"
                                                                                         HorizontalContentAlignment="Center"
                                                                                         Margin="0,0,5,0"
                                                                                         VerticalAlignment="Center"
                                                                                         ToolTip="Fallback: Simulation frames between damage evaluations per grid during continuous contact when damage is permitted. Default: 30 frames."/>
                                                                                <TextBlock Text="Frames during continuous contact."
                                                                                           Foreground="#CCCCCC"
                                                                                           VerticalAlignment="Center"/>
                                                                        </WrapPanel>
                                                                </StackPanel>
                                                        </GroupBox>

                                                        <!-- Player-Made Missiles (PMWs) -->
                                                        <GroupBox Header="🎯 Player-Made Missiles (PMWs)">
                                                                <StackPanel>
                                                                        <CheckBox Content="Allow Player-Made Missile (PMW) Impact Damage"
                                                                                  IsChecked="{Binding Config.AllowMissileDamage}"
                                                                                  FontWeight="SemiBold"
                                                                                  Margin="0,0,0,6"
                                                                                  ToolTip="Allows recognized player-made missiles and kinetic torpedoes to deal full impact deformation damage when striking targets."/>
                                                                        <StackPanel IsEnabled="{Binding Config.AllowMissileDamage}">
                                                                                <TextBlock Text="Allows recognized high-speed player-made missiles and torpedoes within configured block limits to deal full impact deformation damage."
                                                                                           Foreground="#9CA3AF"
                                                                                           FontSize="11"
                                                                                           Margin="16,0,0,8"
                                                                                           TextWrapping="Wrap"/>
                                                                                <CheckBox Content="Piloted Buggy Exemption (Piloted craft never treated as missiles)"
                                                                                          IsChecked="{Binding Config.ExemptPilotedFromMissileStatus}"
                                                                                          Margin="16,2,0,2"
                                                                                          ToolTip="Exempts any craft with an active pilot or cockpit control from ever being classified as a missile, protecting small rovers and fighters."/>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Small Grid Missiles deal impact damage between"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.SmallGridMissileMinBlocks}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Minimum block count for a small grid missile. Default: 4 blocks."/>
                                                                                        <TextBlock Text="and"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.SmallGridMissileMaxBlocks}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Maximum block count for a small grid missile. Grids above this count are protected as ships/rovers. Default: 150 blocks."/>
                                                                                        <TextBlock Text="Blocks."
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Large Grid Missiles deal impact damage between"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.LargeGridMissileMinBlocks}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Minimum block count for a large grid missile. Filters out loose debris or single blocks. Default: 3 blocks."/>
                                                                                        <TextBlock Text="and"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.LargeGridMissileMaxBlocks}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Maximum block count for a large grid missile/torpedo. Grids above this count are protected as ships. Default: 50 blocks."/>
                                                                                        <TextBlock Text="Blocks."
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Require minimum impact velocity of"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.MissileMinVelocity, StringFormat={}{0:F1}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Minimum impact velocity (m/s) required for a missile to deal damage. Slower bumps deal no damage. Default: 20 m/s."/>
                                                                                        <TextBlock Text="m/s to deliver kinetic damage."
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </GroupBox>

                                                        <!-- Layered Armor Occlusion -->
                                                        <GroupBox Header="🛡️ Layered Armor Occlusion">
                                                                <StackPanel>
                                                                        <CheckBox Content="Enable Layered Armor Occlusion"
                                                                                  IsChecked="{Binding Config.EnableLayeredArmorOcclusion}"
                                                                                  FontWeight="SemiBold"
                                                                                  Margin="0,0,0,6"
                                                                                  ToolTip="Intercepts explosion and collision deformation rays to ensure external armor absorbs damage before interior blocks take hits."/>
                                                                        <StackPanel IsEnabled="{Binding Config.EnableLayeredArmorOcclusion}">
                                                                                <TextBlock Text="Simulates ballistic line-of-sight so intact external armor layers absorb and occlude deformation before interior blocks take damage. Physics-less blocks (interior lights, decorative blocks) never occlude damage."
                                                                                           Foreground="#9CA3AF"
                                                                                           FontSize="11"
                                                                                           Margin="16,0,0,8"
                                                                                           TextWrapping="Wrap"/>
                                                                                <CheckBox Content="Armor-Only Occlusion (Strict)"
                                                                                          IsChecked="{Binding Config.ArmorOnlyOcclusion}"
                                                                                          Margin="16,2,0,2"
                                                                                          ToolTip="Strict mode: ONLY pure armor blocks occlude damage, and only while less than 50% deformed - machinery and physics-less blocks (interior lights, decorative) never shield anything behind them. Off = any intact neighbor block counts as armor, however crushed."/>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </GroupBox>


                                                        <!-- Active Push-Apart -->
                                                        <GroupBox Header="🧲 Active Push-Apart (Anti-Stuck Separation)">
                                                                <StackPanel>
                                                                        <CheckBox Content="Enable Active Push-Apart Separation"
                                                                                  IsChecked="{Binding Config.EnablePushApart}"
                                                                                  FontWeight="SemiBold"
                                                                                  Margin="0,0,0,4"
                                                                                  ToolTip="Gently translates grids apart if they remain stuck or phased together in continuous contact. Default: Checked."/>
                                                                        <StackPanel IsEnabled="{Binding Config.EnablePushApart}">
                                                                                <TextBlock Text="Gently nudges stuck or overlapping grids apart along the contact normal or gravity vector after continuous contact."
                                                                                           Foreground="#9CA3AF"
                                                                                           FontSize="11"
                                                                                           Margin="16,0,0,8"
                                                                                           TextWrapping="Wrap"/>
                                                                                <CheckBox Content="Exclude Suspension Wheel Subgrids from Push-Apart"
                                                                                          IsChecked="{Binding Config.ExcludeWheelSubgridsFromPushApart}"
                                                                                          Margin="16,2,0,6"
                                                                                          ToolTip="Wheel-terrain contacts fire every frame while driving. Excluding wheel subgrids prevents the plugin from treating normal rover driving as stuck-in-voxel and micro-teleporting the wheels. Default: Checked."/>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Nudge stuck overlapping grids apart by"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PushApartDistance, StringFormat={}{0:F2}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Base distance in meters for the initial separation nudge (0 = rely purely on escalation/clearance). Repeated pushes within the stuck window escalate progressively. Default: 0.50m."/>
                                                                                        <TextBlock Text="meters initially,"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="escalating repeated attempts up to a maximum of"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PushApartMaxNudgeDistance, StringFormat={}{0:F2}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Ceiling for repeated nudges within the same stuck window. Escalation increments each attempt up to this cap to safely dig out stubborn surface grids (0 = disabled). Subterranean OBB clearance bypasses this cap so buried constructs can emerge completely above the surface in one shot. Default: 2.00m."/>
                                                                                        <TextBlock Text="meters (subterranean clearance bypasses cap)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Trigger separation after remaining in continuous contact for"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PushApartThreshold}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Consecutive collision frames required before triggering separation. Evaluated directly from continuous physics contact callbacks every frame (0 = disabled). Default: 25 frames (~0.4s)."/>
                                                                                        <TextBlock Text="frames."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Give up after"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PushApartMaxAttempts}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 ToolTip="Consecutive separation pushes allowed while a grid remains stuck in voxels (0 = never give up, up to 1000). Prevents grids from endlessly staircasing up cliff faces when pushes cannot free them. When giving up, the grid can optionally be converted to a static station to kill Havok solver saturation. Default: 3."/>
                                                                                        <TextBlock Text="failed push attempts (0 = never give up)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <CheckBox Content="Convert to Static Station when Give-Up Limit is Reached"
                                                                                          IsChecked="{Binding Config.ConvertToStaticOnPushApartGiveUp}"
                                                                                          Margin="16,2,0,4"
                                                                                          ToolTip="Nuclear anti-solver-saturation option: when PushApartMaxAttempts is reached and the grid is still stuck, converts the grid to a static station on the game thread to halt Havok physics vibrations and save server sim-speed. If unchecked, stops pushing without stationing. Default: Checked."/>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Consider grids stuck only if drift remains under"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PushApartMaxDrift, StringFormat={}{0:F1}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Base drift limit in meters (0 = disabled). Grids that moved more than this distance during the contact window are driving, not stuck, and never get pushed. Automatically scales upward with construct bounding radius (Math.Max(Base, Radius * 0.10)) to allow rocking and gyro-yanking on large mobile bases without lockout. Default: 1.5m."/>
                                                                                        <TextBlock Text="meters (scales with construct radius)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Rescue high-centered chassis when mesh penetration exceeds"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PushApartEmbeddedDepth, StringFormat={}{0:F2}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Micro-level physical penetration depth into voxel mesh (meters) required to classify a stationary non-wheel chassis as wedged/high-centered (0 = any non-zero contact qualifies). Default: 0.20m."/>
                                                                                        <TextBlock Text="meters (0 = any contact)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Rescue violent Clang loops when deformation rate exceeds"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PushApartClangRateThreshold}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Blocked deformation rate in clangs/s (0 = disabled) required to classify a contact as violent Havok solver saturation loop (true Clang). Clanging grids qualify for push-apart and bypass resting/drift guards even when Havok reports 0.000m penetration. Default: 500 clangs/s."/>
                                                                                        <TextBlock Text="clangs/s (0 = disabled)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </GroupBox>

                                                        <!-- Vehicle Self-Rescue (!unstuckit) -->
                                                        <GroupBox Header="🛟 Vehicle Self-Rescue (!unstuckit, !rescue)">
                                                                <StackPanel>
                                                                        <CheckBox Content="Enable Player Vehicle Self-Rescue"
                                                                                  IsChecked="{Binding Config.EnablePlayerRescue}"
                                                                                  FontWeight="SemiBold"
                                                                                  Margin="0,0,0,4"
                                                                                  ToolTip="Enables player !unstuckit, !rescue, and !unstuck commands allowing stranded rovers to self-push using the terrain push-apart engine. Admins bypass all cooldowns and anti-exploit restrictions. Default: Checked."/>
                                                                        <StackPanel IsEnabled="{Binding Config.EnablePlayerRescue}">
                                                                                <TextBlock Text="Allows seated drivers and on-foot players to rescue stuck rovers using the automated push-apart engine with strict anti-combat-exploit gates."
                                                                                           Foreground="#9CA3AF"
                                                                                           FontSize="11"
                                                                                           Margin="16,0,0,8"
                                                                                           TextWrapping="Wrap"/>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Require a cooldown of"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PlayerRescueCooldownSeconds}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Global cooldown in seconds per player and per vehicle between rescue attempts. Default: 300s (5 minutes)."/>
                                                                                        <TextBlock Text="seconds between rescue attempts."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Block rescue for"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PlayerRescueCombatCooldownSeconds}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Cooldown in seconds after the vehicle takes collision or weapon damage before rescue is allowed. Default: 30s."/>
                                                                                        <TextBlock Text="seconds after taking damage (anti-combat escape)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Require a warm-up stationary countdown of"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PlayerRescueWarmupSeconds}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Warm-up delay in seconds before executing rescue. Aborts immediately if the vehicle moves, takes damage, or hostiles approach. Default: 5s."/>
                                                                                        <TextBlock Text="seconds before execution."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Abort countdown if vehicle velocity exceeds"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PlayerRescueMaxSpeed, StringFormat={}{0:F1}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Maximum allowable speed in m/s during warm-up. Grids stuck in violent Havok Clang loops are automatically exempted. Default: 1.0 m/s."/>
                                                                                        <TextBlock Text="m/s (Clang vibration loops exempt)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Block rescue if hostile players or enemy grids are within"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PlayerRescueEnemyProximityMeters, StringFormat={}{0:F0}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Distance in meters around player and vehicle scanned for hostile factions or armed enemy grids. Default: 1000m."/>
                                                                                        <TextBlock Text="meters."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Nudge construct along terrain normal by"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PlayerRescuePushDistance, StringFormat={}{0:F1}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="One-shot rescue translation distance in meters normal to the macro terrain surface (subterranean OBB clearance automatically calculated). Default: 1.5m."/>
                                                                                        <TextBlock Text="meters (subterranean clearance applies automatically)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Allow on-foot crosshair raycast targeting up to"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PlayerRescueOnFootMaxDistanceMeters, StringFormat={}{0:F0}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Maximum crosshair raycast distance in meters for on-foot players outside their vehicles. Admins bypass this and have a 1000m range. Default: 50m."/>
                                                                                        <TextBlock Text="meters."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <CheckBox Content="Require Ground Proximity or Active Collision Contacts"
                                                                                          IsChecked="{Binding Config.PlayerRescueRequireNearTerrainOrContact}"
                                                                                          Margin="16,4,0,4"
                                                                                          ToolTip="Prevents flying or orbital grids from using rescue as a propulsion mechanic. Grid must be near a planet surface or actively colliding. Default: Checked."/>

                                                                                <CheckBox Content="Automatically Upright Flipped / Upside-Down Rovers"
                                                                                          IsChecked="{Binding Config.PlayerRescueUprightFlipped}"
                                                                                          Margin="16,2,0,4"
                                                                                          ToolTip="Rotates inverted rovers right-side-up during rescue. Disabled by default so players must rely on gyroscopes and rover engineering. Default: Unchecked."/>

                                                                                <WrapPanel Margin="16,2,0,2"
                                                                                           VerticalAlignment="Center">
                                                                                        <TextBlock Text="Max static OBB subterranean depth"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,5,0"/>
                                                                                        <TextBox Text="{Binding Config.PlayerRescueMaxStaticObbDepthMeters, StringFormat={}{0:F1}}"
                                                                                                 Width="55"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Margin="0,0,5,0"
                                                                                                 ToolTip="Maximum subterranean OBB penetration depth allowed for static vehicle self-rescue or Terminal conversion. Prevents rescuing static stations or deeply buried structures. Default: 4.0m."/>
                                                                                        <TextBlock Text="meters (blocks true stations/bunkers)."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>

                                                                                <CheckBox Content="Enable Terminal 'Convert to Ship' Auto-Rescue for Stranded Vehicles"
                                                                                          IsChecked="{Binding Config.EnableTerminalConvertToShipAutoRescue}"
                                                                                          Margin="16,2,0,4"
                                                                                          ToolTip="When players click 'Convert to Ship' in the Terminal on a static rover or aircraft resting within ~1m of voxels, automatically lifts and converts it to dynamic. Default: Checked."/>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </GroupBox>

                                                        <!-- Voxel & Terrain Protection -->
                                                        <GroupBox Header="🌍 Voxel &amp; Terrain Protection">
                                                                <StackPanel>
                                                                        <CheckBox Content="Suppress Explosion &amp; Clang Voxel Cutouts"
                                                                                  IsChecked="{Binding Config.SuppressAllVoxelExplosionDamage}"
                                                                                  FontWeight="SemiBold"
                                                                                  Margin="0,0,0,6"
                                                                                  ToolTip="Disables voxel crater cutouts from explosions, warheads, weapons, and clangs. Drill mining (hand &amp; ship drills) remains 100% operational!"/>
                                                                        <StackPanel IsEnabled="{Binding Config.SuppressAllVoxelExplosionDamage}">
                                                                                <TextBlock Text="Disables voxel crater cutouts from clangs, warheads, and weapons to preserve roads and terrain while leaving drill mining operational."
                                                                                           Foreground="#9CA3AF"
                                                                                           FontSize="11"
                                                                                           Margin="16,0,0,8"
                                                                                           TextWrapping="Wrap"/>
                                                                        </StackPanel>
                                                                </StackPanel>
                                                        </GroupBox>
                                                </StackPanel>
                                        </StackPanel>
                                </ScrollViewer>
                        </TabItem>

                        <!-- TAB 3: LIVE TELEMETRY & PANIC COCKPIT -->
                        <TabItem Header="Live Telemetry &amp; Actions">
                                <Grid Margin="12,10,12,10">
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- SCROLLABLE COCKPIT CONTENT -->
                                        <ScrollViewer Grid.Row="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Padding="0,0,10,0">
                                                <StackPanel>
                                                        <!-- Header -->
                                                        <TextBlock Text="⚡ Panic Triage Cockpit &amp; Real-Time Telemetry"
                                                                   FontSize="16"
                                                                   FontWeight="Bold"
                                                                   Foreground="#CCCCCC"
                                                                   Margin="0,0,0,4"/>
                                                        <TextBlock Text="Real-time Havok simulation gauges, 60-second trend graph, and 1-click physics rescue tools."
                                                                   FontSize="11"
                                                                   Foreground="#9CA3AF"
                                                                   Margin="0,0,0,10"/>

                                                        <!-- LAYER 1: DYNAMIC DEFCON EMERGENCY BANNER (LOCKED HEIGHT, ZERO JITTER) -->
                                                        <Border Background="{Binding DefenseStats.AlertBackgroundColor, FallbackValue='#202026'}"
                                                                BorderBrush="{Binding DefenseStats.AlertBorderColor, FallbackValue='#4B5563'}"
                                                                BorderThickness="2"
                                                                CornerRadius="6"
                                                                Padding="12,6"
                                                                MinHeight="48"
                                                                Margin="0,0,0,12">
                                                                <Grid VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Status Alert Display -->
                                                                        <StackPanel Grid.Column="0"
                                                                                    Orientation="Horizontal"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="0,0,8,0">
                                                                                <TextBlock Text="{Binding DefenseStats.AlertIcon, FallbackValue='⚪'}"
                                                                                           FontSize="18"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,8,0"/>
                                                                                <TextBlock Text="{Binding DefenseStats.AlertStatusText, FallbackValue='SERVER OFFLINE — Simulation suspended until server starts'}"
                                                                                           FontWeight="Bold"
                                                                                           FontSize="13"
                                                                                           Foreground="#FFFFFF"
                                                                                           VerticalAlignment="Center"
                                                                                           TextWrapping="Wrap"/>
                                                                        </StackPanel>

                                                                        <!-- Standby Indicator when No Active Clangers (Keeps Column 1 sized) -->
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="Rescue Tools: Standby"
                                                                                   Foreground="#9CA3AF"
                                                                                   FontSize="11"
                                                                                   FontStyle="Italic"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="8,0,0,0"
                                                                                   Visibility="{Binding DefenseStats.HasActiveClangers, Converter={StaticResource InvertedBoolToVis}}"/>

                                                                        <!-- Dynamic 1-Click Action Rescue Buttons for Top Offender (Single Row, Non-Wrapping) -->
                                                                        <StackPanel Grid.Column="1"
                                                                                    Orientation="Horizontal"
                                                                                    VerticalAlignment="Center"
                                                                                    Margin="8,0,0,0"
                                                                                    Visibility="{Binding DefenseStats.HasActiveClangers, Converter={StaticResource BoolToVis}}">
                                                                                <Button Content="⚡ FREEZE"
                                                                                        Click="BannerFreezeTopOffender_Click"
                                                                                        Background="#B71C1C"
                                                                                        Foreground="White"
                                                                                        FontWeight="Bold"
                                                                                        BorderThickness="0"
                                                                                        Padding="8,3"
                                                                                        Margin="2,0"
                                                                                        FontSize="11"
                                                                                        ToolTip="Instantly dampens velocities and forces rigid bodies to sleep on the primary clanger."/>
                                                                                <Button Content="🚀 NUDGE"
                                                                                        Click="BannerNudgeTopOffender_Click"
                                                                                        Background="#D97706"
                                                                                        Foreground="White"
                                                                                        FontWeight="Bold"
                                                                                        BorderThickness="0"
                                                                                        Padding="8,3"
                                                                                        Margin="2,0"
                                                                                        FontSize="11"
                                                                                        ToolTip="Nudges the trapped grid along the local planetary gravity up-vector to clear terrain or obstructions."/>
                                                                                <Button Content="{Binding DefenseStats.TopOffender.BannerAnchorButtonText, FallbackValue='⚓ ANCHOR'}"
                                                                                        IsEnabled="{Binding DefenseStats.TopOffender.CanAnchor, FallbackValue=False}"
                                                                                        Click="BannerAnchorTopOffender_Click"
                                                                                        Background="#4B5563"
                                                                                        Foreground="White"
                                                                                        FontWeight="Bold"
                                                                                        BorderThickness="0"
                                                                                        Padding="8,3"
                                                                                        Margin="2,0"
                                                                                        FontSize="11"
                                                                                        ToolTip="Converts the construct's base grid into a static station and zeroes velocity."/>
                                                                                <Button Content="{Binding DefenseStats.TopOffender.BannerDepowerButtonText, FallbackValue='🔌 DEPOWER'}"
                                                                                        IsEnabled="{Binding DefenseStats.TopOffender.CanDepower, FallbackValue=False}"
                                                                                        Click="BannerDepowerTopOffender_Click"
                                                                                        Background="#4B5563"
                                                                                        Foreground="White"
                                                                                        FontWeight="Bold"
                                                                                        BorderThickness="0"
                                                                                        Padding="8,3"
                                                                                        Margin="2,0"
                                                                                        FontSize="11"
                                                                                        ToolTip="Powers off all reactors, batteries, and hydrogen engines across the construct."/>
                                                                                <Button Content="📍 GPS"
                                                                                        Click="BannerCopyGpsTopOffender_Click"
                                                                                        Background="#1F2937"
                                                                                        Foreground="#60A5FA"
                                                                                        FontWeight="Bold"
                                                                                        BorderThickness="1"
                                                                                        BorderBrush="#3B82F6"
                                                                                        Padding="6,3"
                                                                                        Margin="2,0"
                                                                                        FontSize="11"
                                                                                        ToolTip="Copies in-game GPS marker for the culprit's coordinates to your clipboard."/>
                                                                                <Button Content="🚨 FREEZE ALL"
                                                                                        Click="DampenAllClangersButton_OnClick"
                                                                                        Background="#7F1D1D"
                                                                                        Foreground="#FEF08A"
                                                                                        FontWeight="Bold"
                                                                                        BorderThickness="1"
                                                                                        BorderBrush="#F87171"
                                                                                        Padding="8,3"
                                                                                        Margin="2,0"
                                                                                        FontSize="11"
                                                                                        Visibility="{Binding DefenseStats.HasMultipleClangers, Converter={StaticResource BoolToVis}}"
                                                                                        ToolTip="Multiple clangers active! Freezes physics across all clanging constructs server-wide."/>
                                                                        </StackPanel>
                                                                </Grid>
                                                        </Border>

                                                        <!-- LAYER 2: 60-SECOND REAL-TIME PHYSICS TREND GRAPH (FULL WIDTH) -->
                                                        <GroupBox Header="📈 60-Second Real-Time Physics Trend"
                                                                  Margin="0,0,0,12">
                                                                <StackPanel>
                                                                        <!-- Legend -->
                                                                        <DockPanel LastChildFill="False"
                                                                                   Margin="0,0,0,6">
                                                                                <WrapPanel Orientation="Horizontal"
                                                                                           DockPanel.Dock="Left">
                                                                                        <Rectangle Width="10"
                                                                                                   Height="10"
                                                                                                   Fill="#4CAF50"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,4,0"/>
                                                                                        <TextBlock Text="Sim Speed (TPS)"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   Margin="0,0,14,0"/>

                                                                                        <Rectangle Width="10"
                                                                                                   Height="10"
                                                                                                   Fill="#FF9800"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,4,0"/>
                                                                                        <TextBlock x:Name="ContactLoadLegendText"
                                                                                                   Text="Contact Load"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   Margin="0,0,14,0"/>

                                                                                        <Rectangle Width="10"
                                                                                                   Height="10"
                                                                                                   Fill="#EF4444"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,4,0"/>
                                                                                        <TextBlock x:Name="ClangSpikesLegendText"
                                                                                                   Text="Clang Spikes"
                                                                                                   FontSize="10"
                                                                                                   Foreground="#CCCCCC"/>
                                                                                </WrapPanel>
                                                                                <TextBlock Text="Past 60s"
                                                                                           FontSize="10"
                                                                                           Foreground="#6B7280"
                                                                                           DockPanel.Dock="Right"/>
                                                                        </DockPanel>

                                                                        <!-- Canvas for Graph -->
                                                                        <Border Background="#131316"
                                                                                BorderBrush="#27272A"
                                                                                BorderThickness="1"
                                                                                CornerRadius="3">
                                                                                <Canvas x:Name="TelemetryGraphCanvas"
                                                                                        Height="105"
                                                                                        ClipToBounds="True"
                                                                                        SizeChanged="TelemetryGraphCanvas_SizeChanged">
                                                                                        <!-- Reference Grid Lines -->
                                                                                        <Line X1="0"
                                                                                              Y1="10"
                                                                                              X2="1000"
                                                                                              Y2="10"
                                                                                              Stroke="#26262B"
                                                                                              StrokeDashArray="2,4"
                                                                                              StrokeThickness="1"/>
                                                                                        <TextBlock Text="1.0"
                                                                                                   Foreground="#3F3F46"
                                                                                                   FontSize="8"
                                                                                                   Canvas.Left="2"
                                                                                                   Canvas.Top="2"/>

                                                                                        <Line X1="0"
                                                                                              Y1="52"
                                                                                              X2="1000"
                                                                                              Y2="52"
                                                                                              Stroke="#26262B"
                                                                                              StrokeDashArray="2,4"
                                                                                              StrokeThickness="1"/>
                                                                                        <TextBlock Text="0.5"
                                                                                                   Foreground="#3F3F46"
                                                                                                   FontSize="8"
                                                                                                   Canvas.Left="2"
                                                                                                   Canvas.Top="44"/>

                                                                                        <Line X1="0"
                                                                                              Y1="95"
                                                                                              X2="1000"
                                                                                              Y2="95"
                                                                                              Stroke="#26262B"
                                                                                              StrokeDashArray="2,4"
                                                                                              StrokeThickness="1"/>
                                                                                        <TextBlock Text="0.0"
                                                                                                   Foreground="#3F3F46"
                                                                                                   FontSize="8"
                                                                                                   Canvas.Left="2"
                                                                                                   Canvas.Top="87"/>

                                                                                        <!-- Dynamic Graph Polylines -->
                                                                                        <Polyline x:Name="ContactLoadPolyline"
                                                                                                  Stroke="#FF9800"
                                                                                                  StrokeThickness="1.5"
                                                                                                  Opacity="0.75"/>
                                                                                        <Polyline x:Name="ClangSpikesPolyline"
                                                                                                  Stroke="#EF4444"
                                                                                                  StrokeThickness="2"/>
                                                                                        <Polyline x:Name="SimSpeedPolyline"
                                                                                                  Stroke="#4CAF50"
                                                                                                  StrokeThickness="2"/>
                                                                                </Canvas>
                                                                        </Border>
                                                                </StackPanel>
                                                        </GroupBox>

                                                        <!-- LAYER 3: 3-COLUMN METRIC CARDS -->
                                                        <Grid Margin="0,0,0,12">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- CARD 1: HAVOK SIMULATION HEALTH -->
                                                                <GroupBox Grid.Column="0"
                                                                          Header="⚡ Havok Health &amp; Sleep"
                                                                          Margin="0,0,4,0">
                                                                        <StackPanel>
                                                                                <DockPanel LastChildFill="False"
                                                                                           Margin="0,0,0,4">
                                                                                        <TextBlock Text="Sim Speed:"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   DockPanel.Dock="Left"/>
                                                                                        <TextBlock Text="{Binding Telemetry.ServerSimulationSpeedDisplay}"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="{Binding Telemetry.ServerSimulationSpeedColor}"
                                                                                                   DockPanel.Dock="Right"/>
                                                                                </DockPanel>

                                                                                <TextBlock Margin="0,2,0,2"
                                                                                           ToolTip="Total dynamic vs static grids across the server physics world. Dynamic grids have simulated Havok rigid bodies; static stations are fixed collision geometry.">
                                                                                        <Run Text="- Server Grids: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding Telemetry.ServerGridsDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding Telemetry.ServerGridsColor, Mode=OneWay}"/>
                                                                                </TextBlock>

                                                                                <TextBlock Margin="0,2,0,2"
                                                                                           ToolTip="Dynamic grids currently sleeping in Havok (0 CPU) vs total dynamic grids, including grids put to sleep by this plugin.">
                                                                                        <Run Text="- Dynamic Sleep: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding Telemetry.DynamicGridsSleepDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding Telemetry.DynamicGridsSleepColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <ProgressBar Style="{StaticResource DualColorProgressBarStyle}"
                                                                                             Value="{Binding Telemetry.DynamicSleepRatioPercent, Mode=OneWay}"
                                                                                             Maximum="100"
                                                                                             Height="6"
                                                                                             Margin="0,0,0,4"
                                                                                             Foreground="#10B981"
                                                                                             Background="#B45309"
                                                                                             ToolTip="Emerald: Dynamic Grids Sleeping (0 CPU) | Amber: Dynamic Grids Active (Solver Calculating)"/>

                                                                                <TextBlock Margin="0,2,0,0"
                                                                                           ToolTip="Floating ore items merged into single physics entities to eliminate Havok clutter.">
                                                                                        <Run Text="- Merged Ore: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding Telemetry.MergedOreDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding Telemetry.MergedOreColor, Mode=OneWay}"/>
                                                                                </TextBlock>

                                                                                <Separator Background="#3A3A3C"
                                                                                           Margin="0,6,0,4"/>

                                                                                <TextBlock Text="🔥 Hot-Path Engine Rates:"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#9CA3AF"
                                                                                           Margin="0,0,0,2"/>
                                                                                <TextBlock>
                                                                                        <Run Text="- Havok Contacts: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.ContactCallbacksDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.ContactCallbacksColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock>
                                                                                        <Run Text="- Voxel Raycasts: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.VoxelRaycastsDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.VoxelRaycastsColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                        </StackPanel>
                                                                </GroupBox>

                                                                <!-- CARD 2: ROVER & SUBGRID STATUS -->
                                                                <GroupBox Grid.Column="1"
                                                                          Header="🚜 Mobility &amp; Subgrids"
                                                                          Margin="4,0,4,0">
                                                                        <StackPanel>
                                                                                <TextBlock ToolTip="Active tracked rovers and how many parked rovers currently have suspensions frozen.">
                                                                                        <Run Text="- Tracked Rovers: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding Telemetry.RoversDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding Telemetry.RoversColor, Mode=OneWay}"/>
                                                                                </TextBlock>

                                                                                <TextBlock Margin="0,4,0,2"
                                                                                           ToolTip="Individual wheel suspensions across all tracked rovers (Sleeping / Total Tracked).">
                                                                                        <Run Text="- Tracked Wheels: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding Telemetry.SleepingWheelsDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding Telemetry.SleepingWheelsColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <ProgressBar Style="{StaticResource DualColorProgressBarStyle}"
                                                                                             Value="{Binding Telemetry.SleepingWheelsRatioPercent, Mode=OneWay}"
                                                                                             Maximum="100"
                                                                                             Height="6"
                                                                                             Margin="0,0,0,4"
                                                                                             Foreground="#10B981"
                                                                                             Background="#B45309"
                                                                                             ToolTip="Emerald: Wheels Sleeping | Amber: Wheels Active"/>

                                                                                <TextBlock Margin="0,2,0,2"
                                                                                           ToolTip="Pistons, rotors, and hinges with angular velocity dampening applied to eliminate subgrid physics jitter.">
                                                                                        <Run Text="- Subgrid Joints: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding Telemetry.SubgridJointsDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding Telemetry.SubgridJointsColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <ProgressBar Style="{StaticResource DualColorProgressBarStyle}"
                                                                                             Value="{Binding Telemetry.StabilizedJointsRatioPercent, Mode=OneWay}"
                                                                                             Maximum="100"
                                                                                             Height="6"
                                                                                             Margin="0,0,0,4"
                                                                                             Foreground="#38BDF8"
                                                                                             Background="#374151"
                                                                                             ToolTip="Sky Blue: Joints Dampened | Slate: Joints Undampened"/>

                                                                                <TextBlock Margin="0,2,0,2"
                                                                                           ToolTip="Adaptive Time-Of-Impact: Discrete TOI (low CPU overhead) vs Continuous TOI (high-speed penetration protection).">
                                                                                        <Run Text="- Adaptive TOI: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding Telemetry.AdaptiveTOIDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding Telemetry.AdaptiveTOIColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <ProgressBar Style="{StaticResource DualColorProgressBarStyle}"
                                                                                             Value="{Binding Telemetry.DiscreteTOIRatioPercent, Mode=OneWay}"
                                                                                             Maximum="100"
                                                                                             Height="6"
                                                                                             Margin="0,0,0,4"
                                                                                             Foreground="#38BDF8"
                                                                                             Background="#EA580C"
                                                                                             ToolTip="Sky Blue: Discrete TOI (Fast) | Orange: Continuous TOI (Critical)"/>

                                                                                <TextBlock Margin="0,2,0,0"
                                                                                           ToolTip="Active thrusters evaluated with performant nozzle raycasts instead of expensive volumetric shape-casts.">
                                                                                        <Run Text="- Thruster Clearance: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding Telemetry.ThrustersDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding Telemetry.ThrustersColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                        </StackPanel>
                                                                </GroupBox>

                                                                <!-- CARD 3: COLLISION & ARMOR DEFENSE -->
                                                                <GroupBox Grid.Column="2"
                                                                          Header="🛡️ Collision &amp; Armor Defense"
                                                                          Margin="4,0,0,0">
                                                                        <StackPanel>
                                                                                <TextBlock ToolTip="Total deformation collision pairs evaluated by GridDefender.">
                                                                                        <Run Text="- Evaluated Collisions: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.EvaluatedCollisionsDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.EvaluatedCollisionsColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock ToolTip="Total collisions blocked from deforming blocks (with blocked ratio).">
                                                                                        <Run Text="- Clangs Blocked: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.TotalBlockedDisplay, Mode=OneWay}"
                                                                                             FontWeight="Bold"
                                                                                             Foreground="#10B981"/>
                                                                                        <Run Text=" "/>
                                                                                        <Run Text="{Binding DefenseStats.TotalBlockedRatioDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.TotalBlockedColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock ToolTip="Legitimate high-speed PMW kinetic and explosive torpedo impacts allowed through defense.">
                                                                                        <Run Text="- PMW Torpedo Impacts: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.MissileHitsAllowedDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.MissileHitsColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock ToolTip="Internal functional blocks saved from deformation by outer armor layer occlusion.">
                                                                                        <Run Text="- Internal Blocks Saved: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.ArmorHitsOccludedDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.ArmorHitsColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock ToolTip="Overlapping or penetrating grids gently nudged apart to prevent Clang explosions.">
                                                                                        <Run Text="- Grids Nudged Apart: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.GridsSeparatedDisplay, Mode=OneWay}"
                                                                                             FontWeight="Bold"
                                                                                             Foreground="#10B981"/>
                                                                                        <Run Text=" "/>
                                                                                        <Run Text="{Binding DefenseStats.GridsSeparatedPushesDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.GridsSeparatedColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock ToolTip="Vehicles automatically rescued from voxel trapping on dynamic conversion or admin command.">
                                                                                        <Run Text="- Vehicle Rescues: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.PlayerRescuesDisplay, Mode=OneWay}"
                                                                                             FontWeight="Bold"
                                                                                             Foreground="#38BDF8"/>
                                                                                        <Run Text=" ("/>
                                                                                        <Run Text="{Binding DefenseStats.AdminRescuesDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.AdminRescuesColor, Mode=OneWay}"/>
                                                                                        <Run Text=" admin)"/>
                                                                                </TextBlock>
                                                                                <TextBlock ToolTip="Voxel Arbitrator interventions: inverted surface normals clamped and voxel cutout holes prevented.">
                                                                                        <Run Text="- Voxel Arbitrations: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.VoxelNormalsInvertedDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.VoxelNormalsColor, Mode=OneWay}"/>
                                                                                        <Run Text=" norm / "/>
                                                                                        <Run Text="{Binding DefenseStats.VoxelCutoutsPreventedDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.VoxelCutoutsColor, Mode=OneWay}"/>
                                                                                        <Run Text=" hole"/>
                                                                                </TextBlock>
                                                                                <TextBlock ToolTip="Obstructions inside own thruster nozzles vaporized before damaging parent ship.">
                                                                                        <Run Text="- Thruster Blocks Burned: "
                                                                                             Foreground="#9CA3AF"/>
                                                                                        <Run Text="{Binding DefenseStats.ThrusterObstructionsDisplay, Mode=OneWay}"
                                                                                             FontWeight="SemiBold"
                                                                                             Foreground="{Binding DefenseStats.ThrusterObstructionsColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                                <TextBlock Foreground="#9CA3AF"
                                                                                           FontSize="10"
                                                                                           Margin="0,2,0,0">
                                                                                        <Run Text="Caches: "/>
                                                                                        <Run Text="{Binding DefenseStats.CachesDisplay, Mode=OneWay}"
                                                                                             Foreground="{Binding DefenseStats.CachesColor, Mode=OneWay}"/>
                                                                                </TextBlock>
                                                                        </StackPanel>
                                                                </GroupBox>
                                                        </Grid>

                                                        <!-- LAYER 4: LIVE INCIDENT TICKER -->
                                                        <GroupBox Header="🚨 Live Physics Incident Ticker (Recent Solver Interventions)"
                                                                  Margin="0,0,0,12">
                                                                <StackPanel>
                                                                        <TextBlock Text="No physics incidents recorded yet this session. Physics solver running nominal."
                                                                                   Foreground="#9CA3AF"
                                                                                   FontStyle="Italic"
                                                                                   Margin="4,2"
                                                                                   Visibility="{Binding DefenseStats.RecentIncidents, Converter={StaticResource EmptyColToVis}}"/>
                                                                        <ScrollViewer MaxHeight="220"
                                                                                      VerticalScrollBarVisibility="Auto"
                                                                                      HorizontalScrollBarVisibility="Disabled">
                                                                                <ItemsControl ItemsSource="{Binding DefenseStats.RecentIncidents}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                        <Border Background="#1A1A1E"
                                                                                                                BorderBrush="#2D2D35"
                                                                                                                BorderThickness="1"
                                                                                                                CornerRadius="3"
                                                                                                                Padding="6,3"
                                                                                                                Margin="0,1">
                                                                                                                <DockPanel LastChildFill="True">
                                                                                                                        <TextBlock Text="{Binding FormattedTime}"
                                                                                                                                   FontWeight="SemiBold"
                                                                                                                                   Foreground="#60A5FA"
                                                                                                                                   Margin="0,0,8,0"
                                                                                                                                   VerticalAlignment="Center"
                                                                                                                                   DockPanel.Dock="Left"/>
                                                                                                                        <TextBlock Text="{Binding Icon}"
                                                                                                                                   FontSize="12"
                                                                                                                                   Margin="0,0,6,0"
                                                                                                                                   VerticalAlignment="Center"
                                                                                                                                   DockPanel.Dock="Left"/>
                                                                                                                        <TextBlock Text="{Binding DisplayMessage}"
                                                                                                                                   Foreground="#E5E7EB"
                                                                                                                                   VerticalAlignment="Center"
                                                                                                                                   TextWrapping="Wrap"/>
                                                                                                                </DockPanel>
                                                                                                        </Border>
                                                                                                </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                        </ScrollViewer>
                                                                </StackPanel>
                                                        </GroupBox>

                                                        <!-- LAYER 5: FULL-WIDTH SESSION WALL OF CLANG -->
                                                        <GroupBox Margin="0,0,0,12">
                                                                <GroupBox.Header>
                                                                        <DockPanel LastChildFill="False">
                                                                                <TextBlock Text="🏆 Session Wall of Clang — Top Clang Culprits (Last 20 Logged)"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="#F87171"
                                                                                           VerticalAlignment="Center"
                                                                                           DockPanel.Dock="Left"/>
                                                                                <Button Content="🔄 Clear History"
                                                                                        Click="ClearWallOfClang_OnClick"
                                                                                        Padding="6,2"
                                                                                        Margin="0"
                                                                                        Background="#374151"
                                                                                        Foreground="#9CA3AF"
                                                                                        BorderThickness="0"
                                                                                        FontSize="11"
                                                                                        VerticalAlignment="Center"
                                                                                        DockPanel.Dock="Right"
                                                                                        ToolTip="Clears the session list of tracked clanging constructs."/>
                                                                        </DockPanel>
                                                                </GroupBox.Header>
                                                                <StackPanel>
                                                                        <TextBlock Text="No clanging constructs recorded in this session. All grids behaving peacefully!"
                                                                                   Foreground="#9CA3AF"
                                                                                   FontStyle="Italic"
                                                                                   Margin="6,4"
                                                                                   Visibility="{Binding DefenseStats.SessionTopClangers, Converter={StaticResource EmptyColToVis}}"/>

                                                                        <ItemsControl ItemsSource="{Binding DefenseStats.SessionTopClangers}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                                <Border Background="#18181C"
                                                                                                        BorderBrush="#2A2A32"
                                                                                                        BorderThickness="1"
                                                                                                        CornerRadius="4"
                                                                                                        Padding="10,6"
                                                                                                        Margin="0,3">
                                                                                                        <Grid>
                                                                                                                <Grid.ColumnDefinitions>
                                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                                                </Grid.ColumnDefinitions>

                                                                                                                <StackPanel Grid.Column="0"
                                                                                                                            VerticalAlignment="Center">
                                                                                                                        <WrapPanel Orientation="Horizontal"
                                                                                                                                   VerticalAlignment="Center">
                                                                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                                                                           FontWeight="Bold"
                                                                                                                                           FontSize="13"
                                                                                                                                           Foreground="#FFFFFF"
                                                                                                                                           Margin="0,0,8,0"/>
                                                                                                                                <Border Background="#26262B"
                                                                                                                                        CornerRadius="2"
                                                                                                                                        Padding="4,1"
                                                                                                                                        Margin="0,0,8,0">
                                                                                                                                        <TextBlock Text="{Binding StatusDisplay}"
                                                                                                                                                   FontWeight="SemiBold"
                                                                                                                                                   FontSize="11"
                                                                                                                                                   Foreground="{Binding StatusColor}"/>
                                                                                                                                </Border>
                                                                                                                                <TextBlock Text="{Binding LocationDisplay}"
                                                                                                                                           FontSize="11"
                                                                                                                                           Foreground="#60A5FA"
                                                                                                                                           VerticalAlignment="Center"/>
                                                                                                                        </WrapPanel>
                                                                                                                        <TextBlock Text="{Binding SummaryText}"
                                                                                                                                   FontSize="11"
                                                                                                                                   Foreground="#9CA3AF"
                                                                                                                                   Margin="0,2,0,0"/>
                                                                                                                </StackPanel>

                                                                                                                <WrapPanel Grid.Column="1"
                                                                                                                           Orientation="Horizontal"
                                                                                                                           VerticalAlignment="Center"
                                                                                                                           Margin="8,0,0,0">
                                                                                                                        <Button Content="📍 GPS"
                                                                                                                                Tag="{Binding}"
                                                                                                                                Click="OffenderGps_OnClick"
                                                                                                                                Background="#1F2937"
                                                                                                                                Foreground="#60A5FA"
                                                                                                                                BorderBrush="#3B82F6"
                                                                                                                                BorderThickness="1"
                                                                                                                                Padding="6,3"
                                                                                                                                Margin="2,0"
                                                                                                                                FontSize="11"
                                                                                                                                ToolTip="Copies in-game GPS marker for this construct to clipboard."/>
                                                                                                                        <Button Content="🛑 Freeze"
                                                                                                                                Tag="{Binding}"
                                                                                                                                Click="OffenderFreeze_OnClick"
                                                                                                                                Background="#991B1B"
                                                                                                                                Foreground="White"
                                                                                                                                BorderThickness="0"
                                                                                                                                Padding="6,3"
                                                                                                                                Margin="2,0"
                                                                                                                                FontSize="11"
                                                                                                                                ToolTip="Instantly dampens velocities and puts construct rigid bodies to sleep."/>
                                                                                                                        <Button Content="🚀 Nudge"
                                                                                                                                Tag="{Binding}"
                                                                                                                                Click="OffenderNudge_OnClick"
                                                                                                                                Background="#B45309"
                                                                                                                                Foreground="White"
                                                                                                                                BorderThickness="0"
                                                                                                                                Padding="6,3"
                                                                                                                                Margin="2,0"
                                                                                                                                FontSize="11"
                                                                                                                                ToolTip="Nudges this construct along the local planetary gravity up-vector to clear terrain or obstructions."/>
                                                                                                                        <Button Content="{Binding AnchorButtonText, FallbackValue='⚓ Anchor'}"
                                                                                                                                IsEnabled="{Binding CanAnchor, FallbackValue=False}"
                                                                                                                                Tag="{Binding}"
                                                                                                                                Click="OffenderAnchor_OnClick"
                                                                                                                                Background="#374151"
                                                                                                                                Foreground="#E5E7EB"
                                                                                                                                BorderThickness="0"
                                                                                                                                Padding="6,3"
                                                                                                                                Margin="2,0"
                                                                                                                                FontSize="11"
                                                                                                                                ToolTip="Converts construct base grid to a Static Station and freezes physics."/>
                                                                                                                        <Button Content="{Binding DepowerButtonText, FallbackValue='🔌 Depower'}"
                                                                                                                                IsEnabled="{Binding CanDepower, FallbackValue=False}"
                                                                                                                                Tag="{Binding}"
                                                                                                                                Click="OffenderDepower_OnClick"
                                                                                                                                Background="#4B5563"
                                                                                                                                Foreground="#FCA5A5"
                                                                                                                                BorderThickness="0"
                                                                                                                                Padding="6,3"
                                                                                                                                Margin="2,0"
                                                                                                                                FontSize="11"
                                                                                                                                ToolTip="Powers off all reactors, batteries, and hydrogen engines on this construct."/>
                                                                                                                </WrapPanel>
                                                                                                        </Grid>
                                                                                                </Border>
                                                                                        </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                </StackPanel>
                                                        </GroupBox>

                                                        <!-- Global Diagnostics & Console Telemetry Strip -->
                                                        <Border Background="#1E1E24"
                                                                BorderBrush="#3B82F6"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="8,5"
                                                                Margin="0,0,0,12"
                                                                IsEnabled="{Binding Config.Enabled}">
                                                                <StackPanel>
                                                                        <WrapPanel Orientation="Horizontal"
                                                                                   VerticalAlignment="Center">
                                                                                <TextBlock Text="Global Diagnostics:"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#9CA3AF"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,14,0"/>
                                                                                <CheckBox Content="Enable Debug Logging"
                                                                                          IsChecked="{Binding Config.EnableDebugLogging}"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,16,0"
                                                                                          ToolTip="Outputs real-time event logs to Torch console."/>
                                                                                <WrapPanel VerticalAlignment="Center">
                                                                                        <CheckBox Content="Emit Console Telemetry heartbeat every"
                                                                                                  IsChecked="{Binding Config.EnablePeriodicConsoleTelemetry}"
                                                                                                  VerticalAlignment="Center"/>
                                                                                        <TextBox Text="{Binding Config.ConsoleTelemetryIntervalSeconds}"
                                                                                                 Width="45"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="5,0"
                                                                                                 VerticalAlignment="Center"
                                                                                                 IsEnabled="{Binding Config.EnablePeriodicConsoleTelemetry}"/>
                                                                                        <TextBlock Text="Seconds."
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                        </WrapPanel>
                                                                        <WrapPanel Orientation="Horizontal"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,4,0,0">
                                                                                <TextBlock Text="Push-Apart Diagnostics:"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#9CA3AF"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,14,0"/>
                                                                                <CheckBox Content="Log Escape Diagnostics"
                                                                                          IsChecked="{Binding Config.LogPushApartDiagnostics}"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0"/>
                                                                                <CheckBox Content="Log Station Give-Up"
                                                                                          IsChecked="{Binding Config.LogPushApartStationConversion}"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0"/>
                                                                                <CheckBox Content="Enable Debug GPS"
                                                                                          IsChecked="{Binding Config.EnablePushApartDebugDraw}"
                                                                                          VerticalAlignment="Center"/>
                                                                        </WrapPanel>
                                                                        <WrapPanel Orientation="Horizontal"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,4,0,0">
                                                                                <TextBlock Text="Voxel Arbitrator Diagnostics:"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#9CA3AF"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,14,0"/>
                                                                                <CheckBox Content="Enable Arbitrator Debug GPS"
                                                                                          IsChecked="{Binding Config.EnableVoxelNormalArbitratorDebugDraw}"
                                                                                          VerticalAlignment="Center"/>
                                                                        </WrapPanel>
                                                                        <WrapPanel Orientation="Horizontal"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,4,0,0">
                                                                                <TextBlock Text="In-Game Chat Alerts:"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="#9CA3AF"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="0,0,14,0"/>
                                                                                <CheckBox Content="Hourly Digest"
                                                                                          IsChecked="{Binding Config.EnableHourlyChatDigest}"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0"/>
                                                                                <CheckBox Content="Nudge HUD Toasts"
                                                                                          IsChecked="{Binding Config.EnablePushApartPlayerNotification}"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0"/>
                                                                                <CheckBox Content="PMW Faction Telemetry"
                                                                                          IsChecked="{Binding Config.EnablePmwFactionTelemetry}"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="0,0,14,0"/>
                                                                                <WrapPanel VerticalAlignment="Center">
                                                                                        <TextBlock Text="UI Poll:"
                                                                                                   Foreground="#CCCCCC"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,0,4,0"/>
                                                                                        <TextBox Text="{Binding Config.UiRefreshIntervalMs}"
                                                                                                 Width="40"
                                                                                                 HorizontalContentAlignment="Center"
                                                                                                 Margin="0,0,4,0"
                                                                                                 VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="ms"
                                                                                                   Foreground="#FFFFFF"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </WrapPanel>
                                                                        </WrapPanel>
                                                                </StackPanel>
                                                        </Border>
                                                </StackPanel>
                                        </ScrollViewer>

                                        <!-- LAYER 6: FIXED BOTTOM ACTION BAR -->
                                        <Border Grid.Row="1"
                                                Background="#18181B"
                                                BorderBrush="#27272A"
                                                BorderThickness="0,1,0,0"
                                                Padding="4,8,4,2">
                                                <WrapPanel HorizontalAlignment="Center">
                                                        <Button Content="💤 Sleep All Idle Grids"
                                                                Click="SleepAllButton_OnClick"
                                                                Background="#1565C0"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                ToolTip="Manually forces all eligible motionless unpiloted dynamic grids into Havok sleep mode immediately."/>
                                                        <Button Content="⚡ Wake All Grids"
                                                                Click="WakeAllButton_OnClick"
                                                                Background="#00897B"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                ToolTip="Immediately wakes all sleeping dynamic grids and rovers in the world."/>
                                                        <Button Content="⛏️ Proximity Merge Ore"
                                                                Click="MergeOreButton_OnClick"
                                                                Background="#E65100"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                ToolTip="Triggers an immediate proximity merge pass across all floating ore rocks and items in the world."/>
                                                        <Button Content="📋 Copy Diagnostics"
                                                                Click="CopyDiagnosticsButton_OnClick"
                                                                Background="#1976D2"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                ToolTip="Copies the complete diagnostic summary and telemetry metrics to the system clipboard."/>
                                                        <Button Content="💬 Copy Discord Report"
                                                                Click="CopyDiscordReport_OnClick"
                                                                Background="#4F46E5"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                ToolTip="Generates and copies a markdown incident report formatted for Discord."/>

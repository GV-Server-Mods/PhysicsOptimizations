                                                                          IsChecked="{Binding Config.DisableTreePhysics}"
                                                                          FontWeight="SemiBold"
                                                                          Margin="0,0,0,6"
                                                                          ToolTip="Suppresses server-side Havok static compound shape baking and rigid body creation for planet trees and flora. Requires the companion GVK_TreeNoPhysics mod on clients to prevent client desync."/>
                                                                <TextBlock Text="Completely eliminates server-side Havok tree shape baking, broadphase collision queries, and breakable debris math on dedicated servers. When paired with the companion GVK_TreeNoPhysics mod on clients, rovers and ships phase smoothly through trees with zero client desync."
                                                                           Foreground="#9CA3AF"
                                                                           FontSize="11"
                                                                           Margin="16,0,0,4"
                                                                           TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                </GroupBox>

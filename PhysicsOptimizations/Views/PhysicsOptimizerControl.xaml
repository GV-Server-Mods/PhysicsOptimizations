<UserControl x:Class="PhysicsOptimizer.Views.PhysicsOptimizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,2,5,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                    <TextBlock Text="⚡ Physics Optimizer v2.0.0" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="Enable Plugin" IsChecked="{Binding Config.Enabled}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip="Master switch for the entire Physics Optimizer plugin. Disabling suspends all background optimization loops, patches, and collision defenses."/>
                    <CheckBox Content="Enable Physics Optimizations" IsChecked="{Binding Config.EnablePhysicsOptimizations}" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"
                              ToolTip="Master switch for physics optimizations (Tabs 1-5). Disabling pauses all background Havok optimization loops while leaving Grid Defender active."/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                    <Button Content="Save Config to Disk" Click="SaveButton_OnClick" Background="#2E7D32" Foreground="White" BorderThickness="0" 
                            ToolTip="Forces an immediate save of current configuration values to PhysicsOptimizer.cfg on disk."/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Main Tab Control (7 Tabs) -->
        <TabControl Grid.Row="1" Background="#252526" BorderBrush="#333333">

            <!-- TAB 1: WHEEL OPTIMIZER -->
            <TabItem Header="Wheel Optimizer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel IsEnabled="{Binding Config.EnablePhysicsOptimizations}">
                        <!-- Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🏎️ Wheel &amp; Suspension Optimizer Overview:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="Sleeps 60Hz raycasts on parked rovers and masks wheel well armor to eliminate compound shape collision checks against its own chassis." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Wheel & Suspension -->
                        <GroupBox Header="🏎️ Wheel Optimizer">
                            <StackPanel>
                                <CheckBox Content="Enable Wheel Optimizer" IsChecked="{Binding Config.EnableWheelOptimizer}" FontWeight="SemiBold" Margin="0,0,0,6"
                                          ToolTip="Master toggle for wheel and suspension optimizations. Controls parked rover suspension sleep and symmetrical wheel well collision filtering."/>
                                <StackPanel IsEnabled="{Binding Config.EnableWheelOptimizer}">
                                    <TextBlock Text="Sleeps 60Hz raycasts on parked rovers and masks wheel well armor to eliminate compound shape collision checks." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                    <CheckBox Content="Enable Symmetrical Wheel Well Collision Masking" IsChecked="{Binding Config.EnableWheelCollisionFilter}" Margin="16,2,0,2"
                                              ToolTip="Applies Havok collision bitmasks to prevent wheels from performing compound shape collision checks against their own chassis wheel well armor blocks."/>
                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                        <CheckBox Content="Sleep Parked Rover Suspensions after remaining motionless for" IsChecked="{Binding Config.SleepParkedRovers}" VerticalAlignment="Center"
                                                  ToolTip="Suspends 60Hz suspension raycasts, air-shock updates, and brake checks on rovers that are stationary with handbrake engaged. Wakes on input, damage, or movement."/>
                                        <TextBox Text="{Binding Config.RoverSleepDelaySeconds, StringFormat={}{0:F1}}" Width="55" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 IsEnabled="{Binding Config.SleepParkedRovers}"
                                                 ToolTip="Seconds a parked rover must remain motionless before its suspension raycasts are put to sleep. Default: 2.0s."/>
                                        <TextBlock Text="Seconds." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: RIGID BODY SLEEP -->
            <TabItem Header="Rigid Body Sleep">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel IsEnabled="{Binding Config.EnablePhysicsOptimizations}">
                        <!-- Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💤 Rigid Body Sleep Manager Overview:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="Deactivates motionless unpiloted dynamic grids into Havok sleep mode, waking instantly on cockpit input, damage, or movement." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Rigid Body Sleeping -->
                        <GroupBox Header="💤 Rigid Body Sleep">
                            <StackPanel>
                                <CheckBox Content="Enable Rigid Body Sleep" IsChecked="{Binding Config.EnableRigidBodySleep}" FontWeight="SemiBold" Margin="0,0,0,6"
                                          ToolTip="Actively deactivates Havok rigid bodies on idle, unpiloted, and supported dynamic grids into Havok sleep mode to eliminate solver CPU overhead."/>
                                <StackPanel IsEnabled="{Binding Config.EnableRigidBodySleep}">
                                    <TextBlock Text="Deactivates motionless unpiloted dynamic grids into Havok sleep mode, waking instantly on cockpit input, damage, or movement." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>

                                    <StackPanel Margin="16,2,0,2">
                                        <WrapPanel Margin="0,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="Deactivate unpiloted grids when Linear Velocity is below" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.SleepLinearVelocityThreshold, StringFormat={}{0:F2}}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Maximum linear speed below which an unpiloted grid is considered at rest and eligible for Havok sleep. Default: 0.05 m/s."/>
                                            <TextBlock Text="m/s" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="and Angular Velocity is below" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.SleepAngularVelocityThreshold, StringFormat={}{0:F3}}" Width="65" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Maximum rotational speed below which an unpiloted grid is considered at rest and eligible for Havok sleep. Default: 0.01 rad/s."/>
                                            <TextBlock Text="rad/s" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="after remaining motionless for" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.IdleSecondsBeforeSleep}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Consecutive seconds an unpiloted grid must remain under velocity thresholds before entering Havok sleep. Default: 3s."/>
                                            <TextBlock Text="Seconds." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: ORE MERGE -->
            <TabItem Header="Ore Merge">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel IsEnabled="{Binding Config.EnablePhysicsOptimizations}">
                        <!-- Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="⛏️ Floating Object &amp; Ore Optimizer Overview:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="Merges nearby floating ore rocks and items into single larger stacks to slash rigid body counts and accelerate sector cleanup." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Floating Objects & Ore -->
                        <GroupBox Header="⛏️ Ore Merge">
                            <StackPanel>
                                <CheckBox Content="Enable Ore Merge" IsChecked="{Binding Config.EnableOreMerge}" FontWeight="SemiBold" Margin="0,0,0,6"
                                          ToolTip="Master toggle for floating objects and ore optimizations. Merges nearby floating ores and dropped item entities."/>
                                <StackPanel IsEnabled="{Binding Config.EnableOreMerge}">
                                    <TextBlock Text="Merges nearby floating ore rocks and items into single larger stacks to slash rigid body counts and accelerate sector cleanup." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                    
                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                        <CheckBox Content="Auto-Merge Nearby Floating Ore &amp; Items within" IsChecked="{Binding Config.AutoMergeNearbyOre}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Config.OreMergeRadiusMeters, StringFormat={}{0:F1}}" Width="55" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 IsEnabled="{Binding Config.AutoMergeNearbyOre}"
                                                 ToolTip="Spatial radius within which matching floating items and ores will merge into a single item stack. Default: 3.0m."/>
                                        <TextBlock Text="Meters every" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding Config.OreMergeIntervalTicks}" Width="55" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 IsEnabled="{Binding Config.AutoMergeNearbyOre}"
                                                 ToolTip="Simulation frames between proximity merge sweeps (60 = 1 sec, 120 = 2 sec). Default: 120 ticks."/>
                                        <TextBlock Text="Ticks (60 = ~1s)." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>

                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                        <TextBlock Text="Accelerate cleanup when sector floating objects exceed" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding Config.MaxSectorFloatingObjects}" Width="55" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 ToolTip="Maximum threshold of floating objects permitted in a sector before accelerated cleanup and merging are triggered. Default: 64."/>
                                        <TextBlock Text="Items." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: SUBGRID STABILIZER -->
            <TabItem Header="Subgrid Stabilizer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel IsEnabled="{Binding Config.EnablePhysicsOptimizations}">
                        <!-- Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🦾 Subgrid Constraint Stabilizer Overview:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="Micro-dampens constraint tension on resting mechanical joints (rotors, hinges, pistons) and masks small utility subgrids to stop Clang loops." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Subgrid Constraints -->
                        <GroupBox Header="🦾 Subgrid Stabilizer">
                            <StackPanel>
                                <CheckBox Content="Enable Subgrid Stabilizer" IsChecked="{Binding Config.EnableSubgridStabilizer}" FontWeight="SemiBold" Margin="0,0,0,6"
                                          ToolTip="Master toggle for subgrid constraint stabilization. Micro-dampens velocity drift between resting subgrids and parent grids and masks small utility subgrids to eliminate Clang oscillation loops."/>
                                <StackPanel IsEnabled="{Binding Config.EnableSubgridStabilizer}">
                                    <TextBlock Text="Micro-dampens constraint tension on resting mechanical joints (rotors, hinges, pistons) and masks small utility subgrids to stop Clang loops." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>

                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                        <CheckBox Content="Stabilize all mechanical joints when Velocity is below" IsChecked="{Binding Config.EnableSubgridStabilization}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Config.SubgridRestVelocityThreshold, StringFormat={}{0:F3}}" Width="65" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 IsEnabled="{Binding Config.EnableSubgridStabilization}"
                                                 ToolTip="Relative angular velocity threshold below which any mechanical joint (rotors, hinges, pistons across all subgrids) is considered resting and eligible for stabilization. Default: 0.005 rad/s."/>
                                        <TextBlock Text="rad/s for" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding Config.SubgridRestFramesThreshold}" Width="55" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 IsEnabled="{Binding Config.EnableSubgridStabilization}"
                                                 ToolTip="Consecutive motionless frames before stabilizing the joint constraint solver (60 = ~1s). Applies to all mechanical joints across all subgrids. Default: 60 frames."/>
                                        <TextBlock Text="Frames (~1s)." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    
                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                        <CheckBox Content="Mask Small Utility Subgrids under" IsChecked="{Binding Config.MaskSmallUtilitySubgrids}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Config.MaskSmallUtilitySubgridMaxBlocks}" Width="65" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 IsEnabled="{Binding Config.MaskSmallUtilitySubgrids}"
                                                 ToolTip="Maximum block count for a utility subgrid to be eligible for broadphase collision masking. Subgrids with this many blocks or fewer are masked. Default: 10 blocks."/>
                                        <TextBlock Text="Blocks." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: ADAPTIVE COLLISION -->
            <TabItem Header="Adaptive Collision">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel IsEnabled="{Binding Config.EnablePhysicsOptimizations}">
                        <!-- Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🚀 Adaptive TOI &amp; Collision Pruning Overview:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="Demotes cruising and large grids to Discrete collision to slash broadphase CPU load while preserving Continuous TOI for missiles and hazards." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Adaptive TOI / Collision Detection -->
                        <GroupBox Header="🚀 Adaptive Collision">
                            <StackPanel>
                                <CheckBox Content="Enable Adaptive Collision" IsChecked="{Binding Config.EnableAdaptiveCollision}" FontWeight="SemiBold" Margin="0,0,0,6"
                                          ToolTip="Master toggle for dynamic Discrete/Continuous collision quality optimization. Demotes slow, isolated grids to Discrete to save CPU while enforcing Continuous near hazards and high speeds."/>
                                <StackPanel IsEnabled="{Binding Config.EnableAdaptiveCollision}">
                                    <TextBlock Text="Demotes cruising and large grids to Discrete collision to slash broadphase CPU load while preserving Continuous TOI for missiles and hazards." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,4"/>
                                    <TextBlock Margin="16,0,0,8" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap">
                                        <Run Text="• Discrete:" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                        <Run Text=" Checks contacts per tick (slashes CPU load, best for rovers &amp; large grids)."/>
                                        <LineBreak/>
                                        <Run Text="• Continuous (TOI):" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                        <Run Text=" Sweeps path between ticks (prevents high-speed tunneling, burns more CPU)."/>
                                    </TextBlock>

                                    <!-- Section A: Grid-Size Discrete Architecture Overrides -->
                                    <TextBlock Text="Grid-Size Discrete Overrides (Architecture Mode)" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="16,6,0,3"
                                               ToolTip="Forces specified grid sizes into Discrete physics to drastically reduce physics solver load. Works with GridDefender Push-Apart &amp; Anti-Clang for repulsion."/>

                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                        <CheckBox Content="Enforce Discrete on Large Grids over" IsChecked="{Binding Config.EnforceDiscreteLargeGrids}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Config.DiscreteLargeGridMinBlocks}" Width="65" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 IsEnabled="{Binding Config.EnforceDiscreteLargeGrids}"
                                                 ToolTip="Minimum block count for large grids to qualify for forced discrete collision (0 = all large grids). Default: 20 blocks."/>
                                        <TextBlock Text="Blocks." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>

                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                        <CheckBox Content="Enforce Discrete on Small Grids over" IsChecked="{Binding Config.EnforceDiscreteSmallGrids}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Config.DiscreteSmallGridMinBlocks}" Width="65" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                 IsEnabled="{Binding Config.EnforceDiscreteSmallGrids}"
                                                 ToolTip="Minimum block count for small grids to qualify for forced discrete collision (0 = all small grids). Default: 40 blocks."/>
                                        <TextBlock Text="Blocks." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>

                                    <TextBlock Text="🚀 Note: Active PMW missiles (Grid Defender tab) always retain Continuous TOI." Foreground="#9CA3AF" FontSize="10" Margin="16,3,0,6"
                                               ToolTip="Valid player-made missiles configured in Grid Defender always bypass discrete overrides to guarantee impact detection and kinetic penetration."/>

                                    <!-- Section B: Speed Thresholds & Hysteresis -->
                                    <TextBlock Text="Speed Thresholds (Dynamic Fallback)" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="16,6,0,3"
                                               ToolTip="Fallback rules for grids not covered by the discrete overrides above."/>

                                    <StackPanel Margin="16,2,0,2">
                                        <WrapPanel Margin="0,2,0,2" VerticalAlignment="Center">
                                            <CheckBox Content="Demote to Discrete below" IsChecked="{Binding Config.EnableSpeedThresholds}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Config.DiscreteCollisionSpeedThreshold, StringFormat={}{0:F1}}" Width="60" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                     IsEnabled="{Binding Config.EnableSpeedThresholds}"
                                                     ToolTip="Demotion ceiling: Grids cruising below this speed switch to Discrete collision to eliminate expensive broadphase queries. Default: 15 m/s."/>
                                            <TextBlock Text="m/s" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="19,2,0,2" VerticalAlignment="Center" IsEnabled="{Binding Config.EnableSpeedThresholds}">
                                            <TextBlock Text="and promote to Continuous above" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.ContinuousCollisionSpeedThreshold, StringFormat={}{0:F1}}" Width="60" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Promotion floor: Grids accelerating above this speed are immediately restored to Continuous TOI to prevent tunneling. Default: 40 m/s."/>
                                            <TextBlock Text="m/s." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Section C: Safety Overrides (For Non-Overridden Grids) -->
                                    <StackPanel IsEnabled="{Binding Config.EnableSpeedThresholds}">
                                        <TextBlock Text="Safety Reversions (Continuous Overrides)" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="16,6,0,3"
                                                   ToolTip="Safety overrides for dynamic speed thresholds: Keeps slow grids in Continuous TOI when near terrain or other craft to prevent clipping. Active only when Speed Thresholds are enabled."/>

                                        <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                            <CheckBox Content="Force Continuous Near Other Dynamic Grids within" IsChecked="{Binding Config.RevertNearOtherDynamicGrids}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Config.DynamicGridProximityRevertDistanceMeters, StringFormat={}{0:F0}}" Width="65" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                     IsEnabled="{Binding Config.RevertNearOtherDynamicGrids}"
                                                     ToolTip="Distance threshold around dynamic grids within which Continuous TOI is strictly enforced. Default: 500m."/>
                                            <TextBlock Text="Meters." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                            <CheckBox Content="Force Continuous Near Planetary Terrain below" IsChecked="{Binding Config.EnableAltitudeTOIReversion}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Config.ContinuousAltitudeThreshold, StringFormat={}{0:F0}}" Width="65" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                                     IsEnabled="{Binding Config.EnableAltitudeTOIReversion}"
                                                     ToolTip="Planetary surface distance below which Continuous TOI is strictly enforced. Default: 50m."/>
                                            <TextBlock Text="Meters Altitude." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Priority note -->
                                    <TextBlock Text="💡 Priority: PMW Missiles (Continuous) &gt; Grid-Size Discrete &gt; Terrain/Grid Proximity &gt; Speed Thresholds" Foreground="#9CA3AF" FontSize="10" Margin="16,8,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: GRID DEFENDER -->
            <TabItem Header="Grid Defender">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💡 Grid Defender Overview:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="Zero-cost collision defense and kinetic damage interception system. Intercepts Keen's deformation solver to suppress accidental terrain crashes, grief ramming, and subgrid Clang while preserving authentic Havok momentum. Valid player-made missiles (PMWs) deal full kinetic deformation damage, external armor layers occlude interior blocks, kinetic dampening stops rotational death spins, stuck overlapping grids are gently separated, and thruster damage checks use optimized multi-nozzle raycasts." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Master Grid Defender Toggle -->
                        <GroupBox Header="🛡️ Master Grid Defender">
                            <StackPanel>
                                <CheckBox Content="Enable Grid Defender" IsChecked="{Binding Config.EnableGridDefender}" FontWeight="Bold" Margin="0,0,0,6"
                                          ToolTip="Master switch for Grid Defender collision protection, anti-clang damping, and grid separation."/>

                                <StackPanel IsEnabled="{Binding Config.EnableGridDefender}">
                                    <TextBlock Text="Master switch for collision defense and kinetic damage interception. Intercepts Keen's deformation solver to suppress crash damage, scale impact multipliers, and separate grids." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                    <Grid Margin="16,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="Allowed Impact Damage Multiplier (0.0 to 1.0):" Padding="0" VerticalAlignment="Center"
                                               ToolTip="Scale factor when collision impact damage is allowed for missiles (1.0 = normal vanilla damage, 0.5 = 50% damage, 0.0 = zero damage)."/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Minimum="0.0" Maximum="1.0" Value="{Binding Config.DeformationMultiplier}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" Margin="5,0"
                                                    ToolTip="Damage multiplier when impact damage is permitted (e.g., missiles). 1.0 = full damage, 0.0 = zero damage."/>
                                            <TextBox Grid.Column="1" Text="{Binding Config.DeformationMultiplier, StringFormat={}{0:F2}}" Width="50" HorizontalContentAlignment="Center"
                                                     ToolTip="Damage multiplier when impact damage is permitted (e.g., missiles). 1.0 = full damage, 0.0 = zero damage."/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Collision Damage Defense Container -->
                        <StackPanel IsEnabled="{Binding Config.EnableGridDefender}">

                            <!-- Thruster Clearance Optimizer (Sub-feature of Grid Defender) -->
                            <GroupBox Header="🔥 Thruster Clearance Optimizer">
                                <StackPanel>
                                    <CheckBox Content="Enable Thruster Clearance Optimizer" IsChecked="{Binding Config.EnableThrusterClearance}" FontWeight="SemiBold" Margin="0,0,0,6"
                                              ToolTip="Master toggle for raycast-based thruster damage optimizations, multi-nozzle dummy iteration, and radial coverage for large/modded thrusters."/>
                                    <StackPanel IsEnabled="{Binding Config.EnableThrusterClearance}">
                                        <TextBlock Text="Replaces 3D Havok capsule shape-casts with multi-nozzle raycasts, eliminating internal phantom damage while immunizing carrier decks." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                        
                                        <TextBlock Text="Damage Mode:" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="16,6,0,3"/>
                                        <RadioButton Content="Optimized Damage (Anti-Exploit Only)" IsChecked="{Binding Config.IsThrusterModeOptimized}" Foreground="#EEEEEE" Margin="16,2,0,2"
                                                      ToolTip="Maximum performance mode. Raycast clearance checks local construct only: instantly vaporizes illegal internal blocks built directly inside exhaust plumes. External grids (carrier decks, landing pads) are 100% immune (0 damage, 0 Havok phantoms)."/>
                                        <RadioButton Content="Vanilla-Like Damage (Authentic Rate &amp; External Grids)" IsChecked="{Binding Config.IsThrusterModeVanillaLike}" Foreground="#EEEEEE" Margin="16,2,0,2"
                                                      ToolTip="Uses multi-nozzle raycasts to apply gradual, authentic vanilla-rate thermal damage (MyDamageType.Thruster) to both own construct and external grids (landing pads, carrier decks, enemy hulls)."/>
                                        
                                        <TextBlock Text="💡 Optimized mode grants 100% immunity to landing pads and carrier decks. Vanilla-Like mode applies realistic gradual thermal damage across all grids." Foreground="#9CA3AF" FontSize="10" Margin="16,4,0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Ship, Rover & Station Protection -->
                            <GroupBox Header="🚀 Ship, Rover &amp; Station Protection">
                                <StackPanel>
                                    <TextBlock Text="Protects non-missile ships, rovers, stations, and subgrids against collision deformation from ramming, terrain crashes, Clang, and debris." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                    <CheckBox Content="Protect Ships From Ship-on-Ship Ramming" IsChecked="{Binding Config.ProtectShipsAgainstRamming}" Margin="16,2,0,2"
                                              ToolTip="Blocks impact damage when full-sized ships or rovers collide with each other, preventing grief ramming and accidental dock collisions."/>
                                    <CheckBox Content="Protect Ships &amp; Rovers From Voxel (Planet/Asteroid) Crashes" IsChecked="{Binding Config.ProtectShipsAgainstVoxels}" Margin="16,2,0,2"
                                              ToolTip="Blocks impact damage when rovers or ships hit terrain, dunes, or asteroids. Keeps rovers driving smoothly without deformation lag."/>
                                    <CheckBox Content="Protect Static Grids (Stations) From Ramming" IsChecked="{Binding Config.ProtectStaticGrids}" Margin="16,2,0,2"
                                              ToolTip="Suppresses collision impact damage on stations and anchored static structures when rammed by ships."/>
                                    <CheckBox Content="Protect Against Floating Objects / Debris / Ores" IsChecked="{Binding Config.ProtectAgainstFloatingObjects}" Margin="16,2,0,2"
                                              ToolTip="Suppresses impact damage from floating ores, dropped items, and detached debris hitting hulls."/>
                                    <CheckBox Content="Protect Subgrids / Mechanicals (Pistons, Rotors, Hinges) from Clang" IsChecked="{Binding Config.ProtectSubgrids}" Margin="16,2,0,2"
                                              ToolTip="Suppresses self-collision impact damage between connected subgrids (rotors, hinges, pistons) to stop Clang chain reactions."/>

                                    <!-- Fallback Velocity Gates & Damage Rate Limits -->
                                    <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="4" Padding="8" Margin="16,8,0,6">
                                        <TextBlock Text="ℹ️ Fallback Velocity Gates: Applied only when Ramming, Voxel, or Station protection is unchecked above. When all three are checked, full collision immunity is active and these fallback gates are bypassed." 
                                                   Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>
                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center" IsEnabled="{Binding Config.IsSpeedGatesApplicable}">
                                        <TextBlock Text="Safe harbor: Suppress damage when driving below" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding Config.MinDrivingVelocity, StringFormat={}{0:F1}}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                 ToolTip="Fallback: Collisions below this speed never deal damage when ramming or voxel protection is disabled. Default: 10 m/s."/>
                                        <TextBlock Text="m/s." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>

                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center" IsEnabled="{Binding Config.IsSpeedGatesApplicable}">
                                        <TextBlock Text="Anti-crash: Skip deformation processing above" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding Config.MaxDeformationVelocity, StringFormat={}{0:F1}}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                 ToolTip="Fallback: Extreme-speed collisions above this speed skip damage processing to prevent server lag freezes when ramming is allowed. Default: 110 m/s."/>
                                        <TextBlock Text="m/s." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>

                                    <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center" IsEnabled="{Binding Config.IsSpeedGatesApplicable}">
                                        <TextBlock Text="Enforce impact damage cooldown of" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox Text="{Binding Config.DeformationCooldownFrames}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                 ToolTip="Fallback: Simulation frames between damage evaluations per grid during continuous contact when damage is permitted. Default: 30 frames."/>
                                        <TextBlock Text="Frames during continuous contact." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Player-Made Missiles (PMWs) -->
                            <GroupBox Header="🎯 Player-Made Missiles (PMWs)">
                                <StackPanel>
                                    <CheckBox Content="Allow Player-Made Missile (PMW) Impact Damage" IsChecked="{Binding Config.AllowMissileDamage}" FontWeight="SemiBold" Margin="0,0,0,6"
                                              ToolTip="Allows recognized player-made missiles and kinetic torpedoes to deal full impact deformation damage when striking targets."/>
                                    <StackPanel IsEnabled="{Binding Config.AllowMissileDamage}">
                                        <TextBlock Text="Allows recognized high-speed player-made missiles and torpedoes within configured block limits to deal full impact deformation damage." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                        <CheckBox Content="Piloted Buggy Exemption (Piloted craft never treated as missiles)" IsChecked="{Binding Config.ExemptPilotedFromMissileStatus}" Margin="16,2,0,2"
                                                  ToolTip="Exempts any craft with an active pilot or cockpit control from ever being classified as a missile, protecting small rovers and fighters."/>

                                        <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="Small Grid Missiles deal impact damage between" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.SmallGridMissileMinBlocks}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Minimum block count for a small grid missile. Default: 4 blocks."/>
                                            <TextBlock Text="and" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.SmallGridMissileMaxBlocks}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Maximum block count for a small grid missile. Grids above this count are protected as ships/rovers. Default: 150 blocks."/>
                                            <TextBlock Text="Blocks." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="Large Grid Missiles deal impact damage between" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.LargeGridMissileMinBlocks}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Minimum block count for a large grid missile. Filters out loose debris or single blocks. Default: 3 blocks."/>
                                            <TextBlock Text="and" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.LargeGridMissileMaxBlocks}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Maximum block count for a large grid missile/torpedo. Grids above this count are protected as ships. Default: 50 blocks."/>
                                            <TextBlock Text="Blocks." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="Require minimum impact velocity of" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.MissileMinVelocity, StringFormat={}{0:F1}}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Minimum impact velocity (m/s) required for a missile to deal damage. Slower bumps deal no damage. Default: 20 m/s."/>
                                            <TextBlock Text="m/s to deliver kinetic damage." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Layered Armor Occlusion -->
                            <GroupBox Header="🛡️ Layered Armor Occlusion">
                                <StackPanel>
                                    <CheckBox Content="Enable Layered Armor Occlusion" IsChecked="{Binding Config.EnableLayeredArmorOcclusion}" FontWeight="SemiBold" Margin="0,0,0,6"
                                              ToolTip="Intercepts explosion and collision deformation rays to ensure external armor absorbs damage before interior blocks take hits."/>
                                    <StackPanel IsEnabled="{Binding Config.EnableLayeredArmorOcclusion}">
                                        <TextBlock Text="Simulates ballistic line-of-sight so intact external armor layers absorb and occlude deformation before interior blocks take damage." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                        <CheckBox Content="Enforce Structural Armor Check" IsChecked="{Binding Config.EnforceStructuralArmorCheck}" Margin="16,2,0,2"
                                                  ToolTip="Verifies that external armor has actually suffered structural failure before damage propagates into interior functional compartments."/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Anti-Clang & Phasing Prevention -->
                            <GroupBox Header="🌀 Anti-Clang &amp; Phasing Prevention">
                                <StackPanel>
                                    <CheckBox Content="Enable Anti-Clang &amp; Kinetic Absorption System" IsChecked="{Binding Config.EnableAntiClang}" FontWeight="SemiBold" Margin="0,0,0,6"
                                              ToolTip="Absorbs excess kinetic energy on non-damaging collisions to prevent voxel phasing, rubberbanding, and Havok physics loops."/>
                                    <StackPanel IsEnabled="{Binding Config.EnableAntiClang}">
                                        <TextBlock Text="Absorbs excess kinetic energy on non-damaging collisions, arrests rotational death spins, and resolves opposing normal forces in voxels." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                        <CheckBox Content="Stop Clang Death Spins (Zero out extreme rotational velocity)" IsChecked="{Binding Config.StopClangSpinning}" Margin="16,2,0,2"
                                                  ToolTip="Instantly zeros out extreme rotational spin (&gt; 4 rad/s) caused by Havok subgrid glitches before grids rip apart."/>
                                        <CheckBox Content="Enable Voxel Normal Force Arbitrator" IsChecked="{Binding Config.EnableVoxelNormalArbitrator}" Margin="16,2,0,2"
                                                  ToolTip="Inverts opposing normal clamp forces when rovers are pinched into voxels, releasing them cleanly without explosive phantom force spikes."/>
                                        
                                        <Grid Margin="16,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="Impact Velocity Damping (0.0 to 1.0):" Padding="0" VerticalAlignment="Center"
                                                   ToolTip="Velocity absorbed on protected collisions (0.0 = full bounce, 0.5 = 50% absorbed, 1.0 = dead stop). Stops terrain tunneling."/>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" Minimum="0.0" Maximum="1.0" Value="{Binding Config.ImpactVelocityDamping}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" Margin="5,0"
                                                        ToolTip="Velocity absorbed on protected collisions (0.0 = full bounce, 0.5 = 50% absorbed, 1.0 = dead stop). Stops terrain tunneling."/>
                                                <TextBox Grid.Column="1" Text="{Binding Config.ImpactVelocityDamping, StringFormat={}{0:F2}}" Width="50" HorizontalContentAlignment="Center"
                                                         ToolTip="Damage multiplier when impact damage is permitted (e.g., missiles). 1.0 = full damage, 0.0 = zero damage."/>
                                            </Grid>
                                        </Grid>

                                        <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="Engage aggressive kinetic damping after" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.AntiClangVibrationThreshold}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Consecutive collision frames before aggressive damping engages to stop physics vibrations and grinding. Default: 8 frames."/>
                                            <TextBlock Text="Continuous Contact Frames." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Active Push-Apart -->
                            <GroupBox Header="🧲 Active Push-Apart (Anti-Stuck Separation)">
                                <StackPanel>
                                    <CheckBox Content="Enable Active Push-Apart Separation" IsChecked="{Binding Config.EnablePushApart}" FontWeight="SemiBold" Margin="0,0,0,6"
                                              ToolTip="Gently translates grids apart if they remain stuck or phased together in continuous contact."/>
                                    <StackPanel IsEnabled="{Binding Config.EnablePushApart}">
                                        <TextBlock Text="Gently nudges stuck or overlapping grids apart along the contact normal or gravity vector after continuous contact." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                        <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="Nudge stuck overlapping grids apart by" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.PushApartDistance, StringFormat={}{0:F2}}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Distance in meters (0.1 to 5.0m) to gently nudge stuck grids apart along the contact normal or gravity up-vector. Default: 0.5m."/>
                                            <TextBlock Text="Meters" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>

                                        <WrapPanel Margin="16,2,0,2" VerticalAlignment="Center">
                                            <TextBlock Text="after remaining in continuous contact for" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Config.PushApartThreshold}" Width="55" HorizontalContentAlignment="Center" Margin="0,0,5,0" VerticalAlignment="Center"
                                                     ToolTip="Consecutive collision frames (~25 frames = 0.4s) required before triggering separation. Default: 25 frames."/>
                                            <TextBlock Text="Frames (~0.4s)." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Voxel & Terrain Protection -->
                            <GroupBox Header="🌍 Voxel &amp; Terrain Protection">
                                <StackPanel>
                                    <CheckBox Content="Suppress Explosion &amp; Crash Voxel Cutouts" IsChecked="{Binding Config.SuppressAllVoxelExplosionDamage}" FontWeight="SemiBold" Margin="0,0,0,6"
                                              ToolTip="Disables voxel crater cutouts from explosions, warheads, weapons, and crashes. Drill mining (hand &amp; ship drills) remains 100% operational!"/>
                                    <StackPanel IsEnabled="{Binding Config.SuppressAllVoxelExplosionDamage}">
                                        <TextBlock Text="Disables voxel crater cutouts from crashes, warheads, and weapons to preserve roads and terrain while leaving drill mining operational." Foreground="#9CA3AF" FontSize="11" Margin="16,0,0,8"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 7: LIVE TELEMETRY & ACTIONS -->
            <TabItem Header="Live Telemetry &amp; Actions">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Real-Time Havok Gauges, Collision Defense Metrics &amp; Manual Solver Actions" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,10"/>

                    <!-- Global Diagnostics & Console Telemetry Strip (Folded in here from Header) -->
                    <Border Grid.Row="1" Background="#252526" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,12" IsEnabled="{Binding Config.Enabled}">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Global Diagnostics:" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox Content="Enable Debug Logging" IsChecked="{Binding Config.EnableDebugLogging}" VerticalAlignment="Center" Margin="0,0,16,0"
                                      ToolTip="Outputs real-time event logs (sleep/wake transitions, ore merges, subgrid dampening, TOI changes, missile impacts) to the Torch console and torch.log at INFO level."/>
                            <WrapPanel VerticalAlignment="Center">
                                <CheckBox Content="Emit Console Telemetry heartbeat every" IsChecked="{Binding Config.EnablePeriodicConsoleTelemetry}" VerticalAlignment="Center"
                                          ToolTip="Periodically logs a concise 1-line telemetry summary (sim speed, rigid body states, rovers, subgrids, floating items, defense blocks) to the Torch console."/>
                                <TextBox Text="{Binding Config.ConsoleTelemetryIntervalSeconds}" Width="50" HorizontalContentAlignment="Center" Margin="5,0" VerticalAlignment="Center"
                                         IsEnabled="{Binding Config.EnablePeriodicConsoleTelemetry}"
                                         ToolTip="How often (in seconds) the automated 1-line telemetry summary is emitted to the Torch console. Default: 30s."/>
                                <TextBlock Text="Seconds." Foreground="#CCCCCC" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- CARD A: HAVOK SIMULATION HEALTH -->
                        <GroupBox Grid.Row="0" Grid.Column="0" Header="[CARD A] HAVOK SIMULATION HEALTH">
                            <StackPanel>
                                <TextBlock Text="{Binding Telemetry.ServerSimulationSpeed, StringFormat={}- Server Sim Speed: {0:F2} TPS}" Foreground="#4CAF50" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Telemetry.ActiveRigidBodies, StringFormat={}- Active Rigid Bodies: {0:N0}}" />
                                <TextBlock Text="{Binding Telemetry.SleepingRigidBodies, StringFormat={}- Sleeping Rigid Bodies: {0:N0}}" />
                                <TextBlock>
                                    <Run Text="- Dynamic Grids Asleep: "/>
                                    <Run Text="{Binding Telemetry.GridsCurrentlyForcedSleep, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" Foreground="#64B5F6"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Telemetry.TrackedGridsCount, Mode=OneWay, StringFormat=N0}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding Telemetry.ForcedSleepEventsTotal, Mode=OneWay, StringFormat=N0}"/>
                                    <Run Text=" events)"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="- Merged Ore Stacks: "/>
                                    <Run Text="{Binding Telemetry.OreStacksMergedTotal, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" Foreground="#FF9800"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding Telemetry.OreEntitiesEliminatedTotal, Mode=OneWay, StringFormat=N0}"/>
                                    <Run Text=" eliminated)"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <!-- CARD B: ROVER & SUBGRID STATUS -->
                        <GroupBox Grid.Row="0" Grid.Column="1" Header="[CARD B] ROVER &amp; SUBGRID STATUS">
                            <StackPanel>
                                <TextBlock Text="{Binding Telemetry.TrackedRoversCount, StringFormat={}- Tracked Rovers: {0:N0}}" />
                                <TextBlock Text="{Binding Telemetry.ParkedRoversAsleep, StringFormat={}- Parked Rovers Asleep: {0:N0}}" FontWeight="Bold" Foreground="#2196F3"/>
                                <TextBlock>
                                    <Run Text="- Sleeping Wheels: "/>
                                    <Run Text="{Binding Telemetry.SleepingWheelsCount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" Foreground="#00E676"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Telemetry.TotalRoverWheelsCount, Mode=OneWay, StringFormat=N0}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="- Stabilized Subgrid Joints: "/>
                                    <Run Text="{Binding Telemetry.StabilizedSubgridConstraints, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" Foreground="#BA68C8"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Telemetry.TrackedSubgridConstraints, Mode=OneWay, StringFormat=N0}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="- Adaptive TOI Grids: "/>
                                    <Run Text="{Binding Telemetry.DiscreteTOIGridsCount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" Foreground="#81C784"/>
                                    <Run Text=" Disc / "/>
                                    <Run Text="{Binding Telemetry.ContinuousTOIGridsCount, Mode=OneWay, StringFormat=N0}"/>
                                    <Run Text=" Cont"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <!-- CARD C: COLLISION DEFENSE & PMWS -->
                        <GroupBox Grid.Row="1" Grid.Column="0" Header="[CARD C] COLLISION DEFENSE &amp; PMWS">
                            <StackPanel>
                                <TextBlock Text="{Binding DefenseStats.TotalEvaluated, StringFormat={}- Total Collisions Evaluated: {0:N0}}" />
                                <TextBlock>
                                    <Run Text="- Crashes Blocked: "/>
                                    <Run Text="{Binding DefenseStats.TotalBlocked, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" Foreground="#4CAF50"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding DefenseStats.LowSpeedBlocked, Mode=OneWay, StringFormat=N0}"/>
                                    <Run Text=" Low-Speed)"/>
                                </TextBlock>
                                <TextBlock Text="{Binding DefenseStats.BlockRatio, StringFormat={}- Defense Block Ratio: {0:F1}%}" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Text="{Binding DefenseStats.MissileHitsAllowed, StringFormat={}- PMW Torpedo Impacts Allowed: {0:N0}}" FontWeight="Bold" Foreground="#E91E63"/>
                                <TextBlock Text="{Binding DefenseStats.PilotedBuggySaves, StringFormat={}- Piloted Buggy Saves: {0:N0}}" />
                            </StackPanel>
                        </GroupBox>

                        <!-- CARD D: ARMOR & VOXEL PROTECTION -->
                        <GroupBox Grid.Row="1" Grid.Column="1" Header="[CARD D] ARMOR &amp; VOXEL PROTECTION">
                            <StackPanel>
                                <TextBlock Text="{Binding DefenseStats.ArmorHitsOccluded, StringFormat={}- Internal Blocks Saved: {0:N0}}" FontWeight="Bold" Foreground="#64B5F6"/>
                                <TextBlock Text="{Binding DefenseStats.VoxelNormalsInverted, StringFormat={}- Dual-Sided Clamps Inverted: {0:N0}}" />
                                <TextBlock Text="{Binding DefenseStats.ClangVibrationsArrested, StringFormat={}- Clang Vibrations Arrested: {0:N0}}" FontWeight="Bold" Foreground="#FFEB3B"/>
                                <TextBlock Text="{Binding DefenseStats.GridsSeparated, StringFormat={}- Grids Nudged Apart: {0:N0}}" FontWeight="Bold" Foreground="#00E676"/>
                                <TextBlock Text="{Binding DefenseStats.ThrusterObstructionsVaporized, StringFormat={}- Thruster Obstructions Burned: {0:N0}}" />
                                <TextBlock Text="{Binding DefenseStats.VoxelCutoutsPrevented, StringFormat={}- Voxel Cutouts Prevented: {0:N0}}" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>

                    <!-- Bottom Action Controls -->
                    <WrapPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="💤 Force Sleep All Idle Grids" Click="SleepAllButton_OnClick" Background="#1565C0" Foreground="White" BorderThickness="0" 
                                ToolTip="Manually forces all eligible motionless unpiloted dynamic grids into Havok sleep mode immediately."/>
                        <Button Content="⚡ Wake All Grids" Click="WakeAllButton_OnClick" Background="#00897B" Foreground="White" BorderThickness="0" 
                                ToolTip="Immediately wakes all sleeping dynamic grids and rovers in the world."/>
                        <Button Content="⛏️ Run Ore Proximity Merge Now" Click="MergeOreButton_OnClick" Background="#E65100" Foreground="White" BorderThickness="0" 
                                ToolTip="Triggers an immediate proximity merge pass across all floating ore rocks and items in the world."/>
                        <Button Content="📋 Copy Diagnostic Summary" Click="CopyDiagnosticsButton_OnClick" Background="#1976D2" Foreground="White" BorderThickness="0" 
                                ToolTip="Copies the complete diagnostic summary and telemetry metrics to the system clipboard."/>
                        <Button Content="🔄 Reset Counters" Click="ResetCountersButton_OnClick" Background="#C62828" Foreground="White" BorderThickness="0" 
                                ToolTip="Resets all cumulative telemetry and collision defense counters back to zero."/>

<UserControl x:Class="GVK.PhysicsOptimizations.Views.PhysicsOptimizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="750">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Title & Subtitle -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,20,4">
                    <TextBlock Text="⚡ GVK Physics Optimizer" FontSize="18" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="(Wheels, Sleep, Ore, Subgrids &amp; Adaptive TOI)" FontSize="12" Foreground="#888888" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </WrapPanel>

                <!-- Status & Action Button -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                    <TextBlock Text="Changes auto-apply immediately" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Save to Disk" Click="SaveButton_OnClick" Background="#2E7D32" Foreground="White" BorderThickness="0" ToolTip="Force immediate save of configuration to disk."/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="#252526" BorderBrush="#333333">
            <!-- Settings Tab -->
            <TabItem Header="Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Quick Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💡 GVK Physics Optimizer Core Systems:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="• 🏎️ Wheel &amp; Suspension: Eliminates wheel well armor compound queries and sleeps 60Hz raycasts on parked rovers." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• 💤 Rigid Body Sleep: Actively forces idle unpiloted grids into Havok sleep mode with zero-lag wake triggers." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• ⛏️ Ore Proximity Merging: Automatically merges nearby floating ores/items into single larger stacks." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• 🦾 Subgrid Stabilization: Dampens constraint tension on resting mechanical joints to stop Clang vibration loops." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• 🚀 Adaptive TOI: Disables heavy continuous collision checks for low-speed cruising grids while preserving missile CCD." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- General Settings -->
                        <GroupBox Header="General Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Enable Physics Optimizer" IsChecked="{Binding Config.Enabled}" FontWeight="Bold"/>
                                <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="Enable Debug Logging (Log sleep transitions, ore merges, and subgrid events)" IsChecked="{Binding Config.EnableDebugLogging}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Module 1: Wheel & Suspension -->
                        <GroupBox Header="🏎️ Module 1: Wheel &amp; Suspension Optimizer">
                            <StackPanel>
                                <TextBlock Text="Consolidates all rover suspension performance optimizations and wheel broadphase collision masking." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Wheel &amp; Suspension Optimizer" IsChecked="{Binding Config.EnableWheelOptimization}" FontWeight="SemiBold"/>
                                <CheckBox Content="Enable Symmetrical Wheel Well Collision Masking" IsChecked="{Binding Config.EnableWheelCollisionFilter}"/>
                                <CheckBox Content="Sleep Parked Rover Suspensions (Pause 60Hz raycasts &amp; air-shocks when parked)" IsChecked="{Binding Config.SleepParkedRovers}"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Parked Rover Sleep Delay (Seconds):"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.RoverSleepDelaySeconds, StringFormat={}{0:F1}}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Module 2: Rigid Body Sleeping -->
                        <GroupBox Header="💤 Module 2: Rigid Body Sleep Manager">
                            <StackPanel>
                                <TextBlock Text="Forces motionless dynamic grids to enter Havok sleep mode, freeing up CPU solver cycles." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Aggressive Rigid Body Sleeping" IsChecked="{Binding Config.EnableAggressiveSleeping}" FontWeight="SemiBold"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Sleep Linear Velocity (m/s):"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.SleepLinearVelocityThreshold, StringFormat={}{0:F2}}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Sleep Angular Velocity (rad/s):"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.SleepAngularVelocityThreshold, StringFormat={}{0:F3}}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Idle Seconds Before Sleep:"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.IdleSecondsBeforeSleep}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Module 3: Floating Objects & Ore -->
                        <GroupBox Header="⛏️ Module 3: Floating Object &amp; Ore Optimizer">
                            <StackPanel>
                                <TextBlock Text="Merges scattered floating ore rocks and items into single larger stacks to slash rigid body counts." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Floating Object Optimizer" IsChecked="{Binding Config.EnableFloatingObjectOptimizer}" FontWeight="SemiBold"/>
                                <CheckBox Content="Auto-Merge Nearby Floating Ore &amp; Items" IsChecked="{Binding Config.AutoMergeNearbyOre}"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Proximity Merge Radius (Meters):"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.OreMergeRadiusMeters, StringFormat={}{0:F1}}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Merge Interval (Ticks):"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.OreMergeIntervalTicks}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Max Sector Floating Objects:"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.MaxSectorFloatingObjects}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Module 4: Subgrid Constraints -->
                        <GroupBox Header="🦾 Module 4: Subgrid Constraint Stabilizer">
                            <StackPanel>
                                <TextBlock Text="Dampens constraint oscillations on resting mechanical joints (rotors, hinges, pistons)." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Subgrid Stabilization at Rest" IsChecked="{Binding Config.EnableSubgridStabilization}" FontWeight="SemiBold"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Subgrid Rest Velocity (rad/s):"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.SubgridRestVelocityThreshold, StringFormat={}{0:F3}}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Subgrid Rest Frames:"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.SubgridRestFramesThreshold}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Module 5: Adaptive TOI / Collision Detection -->
                        <GroupBox Header="🚀 Module 5: Adaptive TOI / Collision Pruning">
                            <StackPanel>
                                <TextBlock Text="Prunes continuous collision detection on slow grids while keeping high-speed grids &amp; missiles safe." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Enable Adaptive TOI Collision Pruning" IsChecked="{Binding Config.EnableAdaptiveTOI}" FontWeight="SemiBold"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Continuous TOI Speed (m/s):"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.ContinuousCollisionSpeedThreshold, StringFormat={}{0:F1}}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Discrete Collision Speed (m/s):"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.DiscreteCollisionSpeedThreshold, StringFormat={}{0:F1}}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Telemetry & Actions Tab -->
            <TabItem Header="Live Telemetry">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Real-Time Physics Solver Gauges &amp; Manual Actions" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1">
                        <!-- Top Gauges Card -->
                        <Border Background="#1A1A1A" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Active Bodies" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Telemetry.ActiveRigidBodies, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#F44336" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Sleeping Bodies" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Telemetry.SleepingRigidBodies, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Rovers Asleep" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Telemetry.ParkedRoversAsleep, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="Sleeping Wheels" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Telemetry.SleepingWheelsCount, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#00E676" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GroupBox Header="Detailed Telemetry Breakdown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="⛏️ Ore / Item Stacks Merged:"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Telemetry.OreStacksMergedTotal, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF9800"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="🗑️ Floating Objects Eliminated:"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Telemetry.OreEntitiesEliminatedTotal, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFC107"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="💤 Forced Sleep Events Total:"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Telemetry.ForcedSleepEventsTotal, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#64B5F6"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="🦾 Stabilized Subgrid Joints:"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Telemetry.StabilizedSubgridConstraints, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#BA68C8"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="🚀 Grids with Discrete TOI:"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Telemetry.DiscreteTOIGridsCount, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#81C784"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <!-- Bottom Action Controls -->
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="💤 Force Sleep All Idle Grids" Click="SleepAllButton_OnClick" Background="#1565C0" Foreground="White" BorderThickness="0"/>
                        <Button Content="⛏️ Run Ore Proximity Merge Now" Click="MergeOreButton_OnClick" Background="#E65100" Foreground="White" BorderThickness="0"/>
                        <Button Content="🔄 Reset Counters" Click="ResetCountersButton_OnClick" Background="#C62828" Foreground="White" BorderThickness="0"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>


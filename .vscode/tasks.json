{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & Deploy Plugin",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/PhysicsOptimizations/PhysicsOptimizer.csproj",
        "-c",
        "Release",
        "-nologo",
        "-tl:off",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    }
  ]
}
